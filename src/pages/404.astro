---
import Base from '../layouts/Base.astro';
import { urlFor } from '../lib/nav.js';
---
<Base slug="" title="Seite nicht gefunden">
  <script is:inline>
  (function(){
    function track404(){
      if(typeof __fsTrack==='function')__fsTrack('page_not_found',{path:location.pathname,referrer:document.referrer||'direct'});
    }
    document.addEventListener('astro:page-load',track404);
    if(document.readyState!=='loading') track404();
  })();
  </script>
  <div class="wrap e404">
    <div class="code" aria-hidden="true">404</div>
    <h1>Falsch abgebogen</h1>
    <p>Diese Seite gibt es nicht (mehr). Englische und arabische Seiten wurden entfernt; die Seite ist jetzt nur auf Deutsch.</p>
    <a class="back" href={urlFor('')}>Zur Startseite</a>
  </div>
</Base>

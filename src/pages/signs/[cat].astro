---
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import SignSearch from '../../components/solid/SignSearch';
import { urlFor } from '../../lib/nav.js';
import { CATS, byCat, catOf } from '../../lib/signs.js';
export function getStaticPaths() {
  return CATS.map(c => ({ params: { cat: c.id } }));
}
const catId = Astro.params.cat;
const cat = catOf(catId)!;
const signs = byCat(catId);
// eslint-disable-next-line @typescript-eslint/no-explicit-any
const SEARCH = signs.map(({ id, nameDe, de, tipDe, stvo, kw, img, drawn }: any) => ({ id, nameDe, de, tipDe, stvo, kw, img, drawn: img ? undefined : drawn }));
const i = CATS.findIndex(c => c.id === catId);
const prevCat = i > 0 ? CATS[i - 1] : null;
const nextCat = i < CATS.length - 1 ? CATS[i + 1] : null;
---
<Base slug="signs" title={cat.de}>
  <div class="wrap pagehead">
    <span class="kicker">
      <a href={urlFor('signs')} style="color:inherit">Alle Zeichen</a>
      <span aria-hidden="true"> · </span>
      {signs.length} Zeichen
    </span>
    <h1 class="catpage-h1">
      <span class="catpage-dot" style={`--cat-color:${cat.color}`}></span>
      {cat.de}
    </h1>
    <p>{cat.d}</p>
  </div>
  <Section>
    <SignSearch client:visible mode="list" signs={SEARCH} placeholder="In dieser Kategorie suchen" />
    <div class="pn note-mt">
      {prevCat
        ? <a href={urlFor('signs') + prevCat.id + '/'}><span class="dir">← Vorherige</span><span class="t">{prevCat.de}</span></a>
        : <a href={urlFor('signs')}><span class="dir">←</span><span class="t">Alle Zeichen</span></a>}
      {nextCat
        ? <a class="next" href={urlFor('signs') + nextCat.id + '/'}><span class="dir">Nächste →</span><span class="t">{nextCat.de}</span></a>
        : <a class="next" href={urlFor('signs')}><span class="dir">→</span><span class="t">Alle Zeichen</span></a>}
    </div>
  </Section>
</Base>

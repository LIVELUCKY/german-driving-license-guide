---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Lernen from '../components/sections/Lernen.astro';
import TheoriePruefung from '../components/sections/TheoriePruefung.astro';
import TopicTiles from '../components/TopicTiles.astro';
import { urlFor } from '../lib/nav.js';
---
<Base slug="" title="Führerschein-Spickzettel Klasse B">
  <div class="wrap pagehead">
    <span class="kicker">Klasse B · Theorie + Praxis</span>
    <h1>Führerschein-Spickzettel</h1>
    <p>Die Regeln mit ihrem <b>Grund</b>, die Zahlen in ihrer Situation, Karten zum Wischen und deine eigene Fehlerliste.</p>
    <div class="mt-4 flex flex-wrap gap-2">
      <a href={urlFor('vorfahrt')} class="rounded-box border-2 border-line bg-ink px-4 py-2.5 font-bold text-bg shadow-hard">Mit Vorfahrt anfangen →</a>
      <a href={urlFor('ueben')} class="rounded-box border-2 border-line bg-surface px-4 py-2.5 font-bold shadow-hard">🃏 Karten wischen</a>
    </div>
  </div>
  <Section title="Themen"><TopicTiles extra={[{ slug: 'ueben', label: 'Üben', icon: '🃏', d: 'Karten wischen, Quiz, Meine Fehler.' }, { slug: 'praxis', label: 'Praxis', icon: '🚗', d: 'Praktische Prüfung, Manöver, Fehler.' }]} /></Section>
  <Lernen />
  <TheoriePruefung />
</Base>

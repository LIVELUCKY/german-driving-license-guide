---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import JumpNav from '../components/solid/JumpNav';
import { urlFor } from '../lib/nav.js';
import { JUMP } from '../data/cheatsheet';
import Lernen from '../components/sections/Lernen.astro';
import TheoriePruefung from '../components/sections/TheoriePruefung.astro';
import Formeln from '../components/sections/Formeln.astro';
import Zahlenkarte from '../components/sections/Zahlenkarte.astro';
import Tempo from '../components/sections/Tempo.astro';
import Meter from '../components/sections/Meter.astro';
import Vorfahrt from '../components/sections/Vorfahrt.astro';
import Alkohol from '../components/sections/Alkohol.astro';
import Punkte from '../components/sections/Punkte.astro';
import Licht from '../components/sections/Licht.astro';
import Unfall from '../components/sections/Unfall.astro';
import Fahrzeug from '../components/sections/Fahrzeug.astro';
import Verwechselt from '../components/sections/Verwechselt.astro';
import Verhalten from '../components/sections/Verhalten.astro';
import Fragenkatalog from '../components/sections/Fragenkatalog.astro';
import PraxisPruefung from '../components/sections/PraxisPruefung.astro';
import Manoever from '../components/sections/Manoever.astro';
import Fahrtechnik from '../components/sections/Fahrtechnik.astro';
import Situationen from '../components/sections/Situationen.astro';
import Sichern from '../components/sections/Sichern.astro';
import Fehler from '../components/sections/Fehler.astro';
import Quellen from '../components/sections/Quellen.astro';
---
<Base slug="" title="Führerschein-Spickzettel Klasse B">
  <div class="wrap pagehead">
    <span class="kicker">Klasse B · Theorie + Praxis</span>
    <h1>Führerschein-Spickzettel</h1>
    <p>Alle Formeln, Zahlenfragen, Vorfahrt, Dinge, die man gern vergisst, und alle Manöver auf einer Seite. Strg/Cmd + P druckt sie. Gelernt? <a href="#test">Mach den Selbsttest</a>.</p>
  </div>
  <JumpNav client:idle groups={JUMP} />


  <div class="wrap part" id="theorie"><h2>Theorie</h2><span>Was in den 30 Fragen drankommt</span></div>

  <Lernen />
  <TheoriePruefung />
  <Formeln />
  <Zahlenkarte />
  <Tempo />
  <Meter />
  <Vorfahrt />
  <Alkohol />
  <Punkte />
  <Licht />
  <Unfall />
  <Fahrzeug />
  <Verwechselt />
  <Verhalten />
  <Fragenkatalog />
  <div class="wrap part" id="teil-praxis"><h2>Praxis</h2><span>Was der Prüfer im Auto sehen will</span></div>

  <PraxisPruefung />
  <Manoever />
  <Fahrtechnik />
  <Situationen />
  <Sichern />
  <Fehler />
  <Quellen />
  <Section>
    <div class="disc">⚠️ Lernhilfe, kein Ersatz für Fahrschule und amtlichen Fragenkatalog. Alle Verkehrszeichen zum Nachschlagen: <a href={urlFor('signs')}>Zeichen-Katalog →</a></div>
  </Section>

  <script is:inline>
    // Printing: open every fold so nothing is hidden on paper.
    addEventListener('beforeprint', () => document.querySelectorAll('details.fold').forEach(d => { d.open = true; }));
  </script>
</Base>

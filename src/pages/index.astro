---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import { urlFor } from '../lib/nav.js';
import { SIGNS } from '../lib/signs.js';
import ZAHLEN from '../data/zahlenfragen.json';
import Quiz from '../components/Quiz.astro';
// eslint-disable-next-line @typescript-eslint/no-explicit-any
const img = (id: string) => (SIGNS.find((s: any) => s.id === id) as any)?.img;

// Sign pairs people mix up in the exam: [left id, left text, right id, right text].
const PAIRS = [
  ['vorfahrt-gewaehren', '<b>Vorfahrt gewähren</b> (205): nur anhalten, wenn jemand kommt', 'stop', '<b>Stopp</b> (206): <b>immer</b> anhalten, Räder stehen, an der Haltlinie'],
  ['vorfahrt', '<b>Vorfahrt</b> (301): nur an der <b>nächsten</b> Kreuzung', 'vorfahrtstrasse', '<b>Vorfahrtstraße</b> (306): bis zum nächsten Zeichen 205, 206 oder 307'],
  ['eingeschraenktes-halteverbot', '<b>Eingeschränktes Haltverbot</b> (286): bis 3 Min halten, Ein-/Aussteigen, Be-/Entladen ok', 'absolutes-halteverbot', '<b>Absolutes Haltverbot</b> (283): gar nicht halten'],
  ['ueberholverbot', '<b>Überholverbot</b> (276): keine <b>mehrspurigen</b> Kfz. Motorrad, Rad, Mofa darfst du überholen', 'ueberholverbot-fuer-lkw', '<b>Überholverbot Lkw</b> (277): gilt für Kfz über 3,5 t, nicht für Pkw und Bus'],
  ['tempo-30-zone', '<b>Tempo-30-Zone</b> (274.1): 30, meist rechts vor links', 'verkehrsberuhigter-bereich', '<b>Verkehrsberuhigter Bereich</b> (325.1): Schritttempo, Kinder spielen überall, Parken nur auf markierten Flächen'],
] as const;
// Stopping distance per the textbook formulas used in the official question catalogue.
const STOP = [30, 40, 50, 70, 100, 130].map(v => {
  const r = (v / 10) * 3, b = (v / 10) ** 2;
  return { v, r, b, sum: r + b, emergency: b / 2 };
});
const maxStop = Math.max(...STOP.map(s => s.sum));
const pct = (m: number) => (m / maxStop) * 100;

// Each formula: worked chains for 50 and 100 km/h (value, operation, value, …, result) plus a memory hook.
const FORMULAS = [
  { name: 'Reaktionsweg', x: '(v ÷ 10) × 3',
    ex: [['50', 'Null weg', '5', '× 3', '15 m'], ['100', 'Null weg', '10', '× 3', '30 m']],
    m: '1 Sekunde Schreck = 3-mal die Tacho-Ziffer. Bei 2 Sekunden Reaktion doppelt so lang.' },
  { name: 'Bremsweg', x: '(v ÷ 10)²', 
    ex: [['50', 'Null weg', '5', '× 5', '25 m'], ['100', 'Null weg', '10', '× 10', '100 m']],
    m: 'Die Zahl mal sich selbst. Darum wird der Bremsweg bei doppeltem Tempo 4-mal so lang.' },
  { name: 'Gefahrbremsung', x: '(v ÷ 10)² ÷ 2',
    ex: [['50', 'Bremsweg', '25', '÷ 2', '12,5 m'], ['100', 'Bremsweg', '100', '÷ 2', '50 m']],
    m: 'Voll in die Eisen = halber Bremsweg.' },
  { name: 'Anhalteweg', x: 'Reaktionsweg + Bremsweg', hl: true,
    ex: [['50', 'Reaktion + Bremsen', '15 + 25', '=', '40 m'], ['100', 'Reaktion + Bremsen', '30 + 100', '=', '130 m']],
    m: 'Erst erschrecken, dann bremsen: beides zusammen. Das Auto steht erst nach dem Anhalteweg.' },
  { name: 'Anhalteweg bei Gefahr', x: 'Reaktionsweg + Bremsweg ÷ 2',
    ex: [['50', 'Reaktion + halber Bremsweg', '15 + 12,5', '=', '27,5 m'], ['100', 'Reaktion + halber Bremsweg', '30 + 50', '=', '80 m']],
    m: 'Nur der Bremsweg wird halbiert, der Reaktionsweg bleibt.' },
  { name: 'Sicherheitsabstand', x: 'v ÷ 2 (in Metern)',
    ex: [['80', 'halbieren', '40 m'], ['100', 'halbieren', '50 m']],
    m: '„Halber Tacho“. Ohne Zahlen: 2 Sekunden Abstand, „einundzwanzig, zweiundzwanzig“.' },
  { name: 'Anhänger mit Klasse B', x: '3.500 − Pkw (zul. Gesamtmasse)',
    ex: [['3.500 kg', '− Pkw 2.400 kg', '1.100 kg Anhänger']],
    m: 'Bis 750 kg geht immer. Schwerer nur, wenn Pkw + Anhänger zusammen höchstens 3.500 kg (zulässig) wiegen.' },
  { name: 'Stützlast', x: 'mind. 4 % vom Anhänger',
    ex: [['600 kg', '× 4 %', '24 kg']],
    m: 'Vier Prozent drücken auf die Kupplung, sonst schlingert der Anhänger.' },
  { name: 'Überholweg (Idee hinter 800 m)', x: 'Strecke × v ÷ (v − v Lkw)',
    ex: [['100 gegen 70 km/h', 'Überholweg', '≈ 410 m', '+ Gegenverkehr fährt gleich weit', '≈ 800 m Sicht']],
    m: 'Du überholst nur mit der Differenz (30 km/h). Der Gegenverkehr fährt dir in der gleichen Zeit genauso weit entgegen. Darum braucht man doppelt so viel freie Sicht.' },
] as const;

// Distances in metres, drawn as bars on one shared scale (max 50 m).
const RULER = [
  { m: 1.5, t: 'Seitenabstand zu Rad, E-Scooter, Fußgänger', s: 'innerorts (§ 5 Abs. 4)' },
  { m: 2,   t: 'Seitenabstand zu Rad, E-Scooter, Fußgänger', s: 'außerorts' },
  { m: 3,   t: 'Restfahrbahn bis zur durchgezogenen Linie, sonst Parkverbot', s: 'Zeichen 295' },
  { m: 5,   t: 'Parkverbot vor und hinter Kreuzung/Einmündung', s: '§ 12 Abs. 3' },
  { m: 5,   t: 'Haltverbot vor dem Zebrastreifen (und darauf)', s: 'Zeichen 293' },
  { m: 5,   t: 'Parkverbot vor und hinter Andreaskreuz innerorts', s: 'Zeichen 201' },
  { m: 5,   t: 'Abschleppseil: maximaler Abstand', s: '§ 43 StVZO' },
  { m: 8,   t: 'Parkverbot vor Kreuzung, wenn rechts ein baulicher Radweg ist', s: 'nur davor' },
  { m: 10,  t: 'Haltverbot vor Ampel, Andreaskreuz, Vorfahrt gewähren, Stopp', s: 'nur wenn du sie verdeckst' },
  { m: 15,  t: 'Parkverbot vor und hinter Haltestellenschild', s: 'Zeichen 224' },
  { m: 50,  t: 'Parkverbot vor und hinter Andreaskreuz außerorts', s: 'Zeichen 201' },
  { m: 50,  t: 'Abstand Lkw > 3,5 t / Bus auf Autobahn ab 50 km/h', s: '§ 4 Abs. 3' },
  { m: 50,  t: 'Leitpfosten stehen alle …', s: 'zum Schätzen von Abstand und Sicht' },
];
---
<Base slug="" title="Führerschein-Spickzettel Klasse B">
  <div class="wrap pagehead">
    <span class="kicker">Klasse B · Theorie + Praxis</span>
    <h1>Führerschein-Spickzettel</h1>
    <p>Alle Formeln, Zahlenfragen, Vorfahrt, Dinge, die man gern vergisst, und alle Manöver auf einer Seite. Strg/Cmd + P druckt sie. Gelernt? <a href="#test">Mach den Selbsttest</a>.</p>
  </div>
  <nav class="jump" aria-label="Abschnitte">
    <div class="wrap jump-row">
      <b>Theorie</b>
      <a href="#pruefung">Prüfung</a><a href="#formeln">Formeln</a><a href="#zahlen">Zahlenfragen</a><a href="#test">Selbsttest</a><a href="#tempo">Tempo</a><a href="#meter">Meter</a><a href="#alkohol">Alkohol</a><a href="#punkte">Punkte</a><a href="#licht">Licht &amp; Wetter</a><a href="#unfall">Unfall</a><a href="#fahrzeug">Fahrzeug</a><a href="#vorfahrt">Vorfahrt</a><a href="#vergessen">Oft verwechselt</a><a href="#verhalten">Oft gefragt</a>
      <b>Praxis</b>
      <a href="#praxis">Prüfung</a><a href="#blick">Blick</a><a href="#aufgaben">Manöver</a><a href="#fahren">Fahrtechnik</a><a href="#situationen">Im Verkehr</a><a href="#sichern">Sichern</a><a href="#fehler">Sofort durch</a><a href="#quellen">Quellen</a>
    </div>
  </nav>


  <div class="wrap part" id="theorie"><h2>Theorie</h2><span>Was in den 30 Fragen drankommt</span></div>

  <Section id="pruefung" title="Theorieprüfung in Zahlen">
    <div class="stats">
      <div class="stat"><b>30</b><span>Fragen<br/>20 Grundstoff + 10 Klasse B</span></div>
      <div class="stat"><b>2–5</b><span>Fehlerpunkte<br/>pro Frage</span></div>
      <div class="stat ok"><b>≤ 10</b><span>Fehlerpunkte<br/>= bestanden</span></div>
      <div class="stat bad"><b>2×5</b><span>zwei 5-Punkte-Fragen falsch<br/>= durchgefallen</span></div>
      <div class="stat"><b>12</b><span>Monate gültig<br/>bis zur Praxisprüfung</span></div>
    </div>
    <p class="note note-mt">Bei Mehrfachauswahl zählt eine Frage nur, wenn <b>alle</b> richtigen Kreuze gesetzt sind. Mindestens eine Antwort ist immer richtig.</p>
  </Section>

  <Section id="formeln" title="Formeln">
    <div class="formula-key">
      <span>Tacho ÷ 10</span><i>dann</i><span><b>× 3</b> Reaktion</span><span><b>hoch 2</b> Bremsen</span><span><b>÷ 2</b> Gefahr</span><span><b>+</b> Anhalten</span>
    </div>
    <p class="note note-mb"><b>Merksatz:</b> „Null weg, <b>mal drei</b> fürs Erschrecken, <b>mal sich selbst</b> fürs Bremsen, <b>halbe</b> in Gefahr, <b>zusammen</b> zum Stehen.“</p>
    <div class="fcards">
      {FORMULAS.map(f => (
        <div class={`fcard${'hl' in f ? ' hl' : ''}`}>
          <div class="fc-h"><b>{f.name}</b><code>{f.x}</code></div>
          {f.ex.map(chain => (
            <div class="chain">{chain.map((c, i, a) => <span class={i === a.length - 1 ? 'res' : i % 2 ? 'op' : ''}>{c}</span>)}</div>
          ))}
          <p class="fc-m">💡 {f.m}</p>
        </div>
      ))}
    </div>

    <h3 class="sub-h">Anhalteweg im Vergleich</h3>
    <div class="bars" role="img" aria-label="Anhalteweg bei 30, 40, 50, 70, 100 und 130 km/h">
      {STOP.map(s => (
        <div class="bar-row">
          <span class="bar-v">{s.v}</span>
          <div class="bar-track">
            <span class="bar-r" style={`width:${pct(s.r)}%`}></span><span class="bar-b" style={`width:${pct(s.b)}%`}></span>
          </div>
          <span class="bar-sum">{s.sum} m</span>
        </div>
      ))}
      <div class="legend"><span class="lg-r"></span>Reaktionsweg <span class="lg-b"></span>Bremsweg</div>
    </div>

    <div class="grid cols3 note-mt">
      <div class="card">
        <h3><span>✖️</span>Quadrat-Regel</h3>
        <div class="kv"><span class="lab">doppelt so schnell</span><span class="val">4 × Bremsweg</span></div>
        <div class="kv"><span class="lab">dreimal so schnell</span><span class="val">9 × Bremsweg</span></div>
        <div class="kv"><span class="lab">Reaktionsweg</span><span class="val">wächst nur ×2 / ×3</span></div>
        <div class="kv"><span class="lab">Fliehkraft in der Kurve</span><span class="val">auch im Quadrat: 2× Tempo = 4×</span></div>
        <div class="tip">Bremsweg und Fliehkraft wachsen <b>im Quadrat</b>, Reaktionsweg nur <b>einfach</b>.</div>
      </div>
      <div class="card">
        <h3><span>📏</span>Sicherheitsabstand</h3>
        <div class="kv"><span class="lab">außerorts</span><span class="val">halber Tacho in m</span></div>
        <div class="kv"><span class="lab">100 km/h</span><span class="val">50 m</span></div>
        <div class="kv"><span class="lab">Faustregel</span><span class="val">2 Sekunden</span></div>
        <div class="kv"><span class="lab">Stadt, 50 km/h</span><span class="val">15 m = 3 Pkw-Längen</span></div>
        <div class="tip">„<b>Einundzwanzig, zweiundzwanzig</b>“ zählen, ab dem Leitpfosten, den der Vordermann passiert.</div>
      </div>
      <div class="card">
        <h3><span>⏱️</span>Reaktionszeit</h3>
        <div class="kv"><span class="lab">Faustformel</span><span class="val">1 Sekunde</span></div>
        <div class="kv"><span class="lab">länger durch</span><span class="val">Müdigkeit, Alkohol, Ablenkung</span></div>
        <div class="tip">In 1 Sekunde fährst du bei 50 km/h etwa <b>14 m</b> blind (km/h ÷ 3,6 = m/s).</div>
      </div>
    </div>
  </Section>

  <Section id="zahlen" title="Zahlenfragen aus dem Fragenkatalog">
    <p class="note note-mb">Frage → Antwort. Die kleine Nummer ist die Fragennummer im amtlichen Katalog.</p>
    {ZAHLEN.map(g => (
      <>
        <h3 class="sub-h">{g.h}</h3>
        <div class="qa">
          {g.rows.map(r => <div><span><Fragment set:html={r.q} /><small>{r.n}</small></span><b set:html={r.a} /></div>)}
        </div>
      </>
    ))}
  </Section>

  <Section id="test" title="Selbsttest">
    <p class="note note-mb">Erst rechnen oder antworten, dann aufdecken. Ehrlich bewerten: was du nicht wusstest, kommt später nochmal.</p>
    <Quiz />
  </Section>

  <Section id="tempo" title="Tempo">
    <div class="tablewrap">
      <table class="spd">
        <thead><tr><th>Fahrzeug</th><th>Innerorts</th><th>Außerorts</th><th>Kraftfahrstraße</th><th>Autobahn</th></tr></thead>
        <tbody>
          <tr><td>Pkw, Motorrad</td><td><b class="p50">50</b></td><td><b class="p100">100</b></td><td><b class="p100">100</b> · frei bei getrennten Fahrbahnen*</td><td><b class="pfree">frei</b> · 130 empfohlen</td></tr>
          <tr><td>Pkw mit Anhänger</td><td><b class="p50">50</b></td><td><b class="p80">80</b></td><td><b class="p80">80</b> · 100 mit Plakette bei getrennten Fahrbahnen</td><td><b class="p80">80</b> · 100 mit Tempo-100-Plakette</td></tr>
          <tr><td>Kfz 3,5–7,5 t (außer Pkw)</td><td><b class="p50">50</b></td><td><b class="p80">80</b></td><td><b class="p80">80</b></td><td><b class="p80">80</b></td></tr>
          <tr><td>Lkw über 7,5 t</td><td><b class="p50">50</b></td><td><b class="p60">60</b></td><td><b class="p60">60</b> · 80 bei getrennten Fahrbahnen</td><td><b class="p80">80</b></td></tr>
          <tr><td>Bus</td><td><b class="p50">50</b></td><td><b class="p80">80</b></td><td><b class="p80">80</b></td><td><b class="p80">80</b> · Reisebus mit Zulassung 100</td></tr>
          <tr><td>Bus mit stehenden Fahrgästen</td><td><b class="p50">50</b></td><td><b class="p60">60</b></td><td><b class="p60">60</b></td><td><b class="p60">60</b></td></tr>
          <tr><td>Moped, S-Pedelec</td><td><b class="p50">45</b></td><td><b class="p50">45</b></td><td>verboten</td><td>verboten</td></tr>
        </tbody>
      </table>
    </div>
    <p class="note note-mt">* Kraftfahrstraße mit baulich getrennten Fahrbahnen oder 2 Fahrstreifen je Richtung: für Pkw kein allgemeines Limit. S-Pedelec = Kraftfahrzeug: Führerschein, Versicherungskennzeichen, Helm, keine Radwege. Schilder gehen immer vor.</p>
    <div class="tip note-mt"><b>Merksatz:</b> außerorts gilt „Anhänger, Bus oder über 3,5 t = 80, über 7,5 t = 60“. Lkw bis 3,5 t ohne Anhänger: 100. 130 auf der Autobahn ist nur <b>Richtgeschwindigkeit</b>.</div>

    <div class="chips note-mt">
      <div><b class="p50">50</b> bei <b>Sicht unter 50 m</b> (Nebel, Schnee, Regen), überall</div>
      <div><b class="p50">50</b> mit <b>Schneeketten</b></div>
      <div><b class="p50">50</b> ab der <b>Ortstafel</b> sofort. Ende eines Limits innerorts = wieder 50, nicht frei</div>
      <div><b class="p30">30</b> in der <b>Tempo-30-Zone</b> (flächig, meist rechts vor links)</div>
      <div><b class="p30">30</b> in Fahrradstraße und Fahrradzone, für alle Fahrzeuge</div>
      <div><b class="pwalk">Schritt</b> Schrittgeschwindigkeit (ca. 4–7 km/h, keine feste Zahl im Gesetz): verkehrsberuhigter Bereich, Bus mit Warnblinker an Haltestelle</div>
      <div><b class="pmin">&gt;60</b> Autobahn und Kraftfahrstraße nur für Kfz, die bauartbedingt <b>schneller als 60</b> fahren</div>
    </div>
  </Section>

  <Section id="meter" title="Die wichtigen Meter">
    <div class="ruler">
      {RULER.map(r => (
        <div class="rl">
          <span class="rl-m">{String(r.m).replace('.', ',')} m</span>
          <span class="rl-bar"><span style={`width:${Math.max(r.m / 50 * 100, 2)}%`}></span></span>
          <span class="rl-t">{r.t}<small>{r.s}</small></span>
        </div>
      ))}
    </div>
    <div class="tip note-mt"><b>Merksatz Parken:</b> <b>5</b> an der Kreuzung, <b>8</b> mit Radweg, <b>15</b> an der Haltestelle. <b>Halten</b> = bis 3 Minuten und du bleibst da. Länger oder ausgestiegen = <b>Parken</b>.</div>

    <h3 class="sub-h">Baken und Gefahrzeichen</h3>
    <div class="grid cols2">
      <div class="card">
        <h3><span>🚂</span>Bahnübergang</h3>
        <div class="diag">
          <svg viewBox="0 0 320 110" role="img" aria-label="Baken vor dem Bahnübergang bei 240, 160 und 80 Metern">
            <rect x="0" y="70" width="320" height="16" fill="#c7ced6"/>
            <g transform="translate(40,10)"><rect width="16" height="56" fill="#fff" stroke="#17171b"/><path d="M0 14 L16 6 M0 30 L16 22 M0 46 L16 38" stroke="#d92f2f" stroke-width="5"/></g>
            <g transform="translate(130,10)"><rect width="16" height="56" fill="#fff" stroke="#17171b"/><path d="M0 22 L16 14 M0 40 L16 32" stroke="#d92f2f" stroke-width="5"/></g>
            <g transform="translate(220,10)"><rect width="16" height="56" fill="#fff" stroke="#17171b"/><path d="M0 32 L16 24" stroke="#d92f2f" stroke-width="5"/></g>
            <path d="M290 20 L310 60 M310 20 L290 60" stroke="#d92f2f" stroke-width="6"/>
            <text x="48" y="104" font-size="13" text-anchor="middle" font-weight="800" fill="var(--ink)">240 m</text>
            <text x="138" y="104" font-size="13" text-anchor="middle" font-weight="800" fill="var(--ink)">160 m</text>
            <text x="228" y="104" font-size="13" text-anchor="middle" font-weight="800" fill="var(--ink)">80 m</text>
          </svg>
        </div>
        <p class="note"><b>Merksatz:</b> jeder Streifen = 80 m. Ab der ersten Bake (Zeichen 156) <b>keine Kraftfahrzeuge überholen</b>. Andreaskreuz = Bahn hat <b>immer</b> Vorrang.</p>
      </div>
      <div class="card">
        <h3><span>⚠️</span>Wo Schilder stehen</h3>
        <div class="kv"><span class="lab">Gefahrzeichen außerorts</span><span class="val">150–250 m vor der Gefahr</span></div>
        <div class="kv"><span class="lab">Gefahrzeichen innerorts</span><span class="val">meist kürzer davor</span></div>
        <div class="kv"><span class="lab">Autobahn-Ausfahrt</span><span class="val">Baken 300 / 200 / 100 m</span></div>
        <div class="kv"><span class="lab">Leitpfosten</span><span class="val">alle 50 m</span></div>
        <div class="tip">Deutlich kürzer? Dann steht die Entfernung auf einer Zusatztafel („in 50 m“).</div>
      </div>
    </div>
  </Section>

  <Section id="alkohol" title="Alkohol und Drogen">
    <div class="scale" role="img" aria-label="Promilleskala">
      <div class="sc-track">
        <span class="z0" style="width:0.5%"></span>
        <span class="z1" style="width:16%"></span>
        <span class="z2" style="width:11%"></span>
        <span class="z3" style="width:33%"></span>
        <span class="z4" style="width:39.5%"></span>
      </div>
      <div class="sc-ticks">
        <span><b>0,0</b>Probezeit &amp; unter 21: Grenze</span>
        <span><b>0,3</b>mit Ausfallerscheinung (z. B. Unfall wegen Alkohol): Straftat</span>
        <span><b>0,5</b>immer: Ordnungswidrigkeit, Fahrverbot</span>
        <span><b>1,1</b>absolut fahruntüchtig: Straftat</span>
        <span><b>1,6</b>MPU (auch auf dem Fahrrad)</span>
      </div>
    </div>
    <div class="grid cols3 note-mt">
      <div class="card">
        <h3><span>🍺</span>Abbau</h3>
        <div class="kv"><span class="lab">pro Stunde</span><span class="val">ca. 0,1 ‰</span></div>
        <div class="tip">Kaffee, Schlaf oder Dusche beschleunigen <b>nichts</b>. Nur Zeit hilft. Restalkohol am Morgen zählt.</div>
      </div>
      <div class="card">
        <h3><span>🌿</span>Cannabis</h3>
        <div class="kv"><span class="lab">THC-Grenzwert</span><span class="val">3,5 ng/ml</span></div>
        <div class="kv"><span class="lab">mit Alkohol</span><span class="val">verboten</span></div>
        <div class="kv"><span class="lab">Probezeit / unter 21</span><span class="val">verboten</span></div>
      </div>
      <div class="card">
        <h3><span>💊</span>Medikamente</h3>
        <div class="tip">Beipackzettel lesen. Wer fahruntüchtig ist, macht sich strafbar, auch mit Rezept. Andere illegale Drogen: <b>null</b> Toleranz.</div>
      </div>
      <div class="card">
        <h3><span>😴</span>Müdigkeit</h3>
        <div class="kv"><span class="lab">Pause</span><span class="val">alle ca. 2 Stunden</span></div>
        <div class="kv"><span class="lab">Powernap</span><span class="val">Kaffee + ca. 20 Min Schlaf</span></div>
        <div class="tip">Sekundenschlaf: bei 100 km/h fährst du in 1 Sekunde fast <b>28 m</b> blind.</div>
      </div>
    </div>
    <div class="tip note-mt"><b>Merksatz:</b> <b>0,0</b> wenn du neu bist, <b>0,3</b> wenn etwas passiert, <b>0,5</b> immer, <b>1,1</b> Straftat, <b>1,6</b> MPU.</div>
  </Section>

  <Section id="punkte" title="Punkte und Probezeit">
    <div class="points" role="img" aria-label="Punkteskala Flensburg">
      {[1,2,3,4,5,6,7,8].map(n => <span class={n <= 3 ? 'pt0' : n <= 5 ? 'pt1' : n <= 7 ? 'pt2' : 'pt3'}>{n}</span>)}
    </div>
    <div class="points-l">
      <span class="pt0">1–3 vorgemerkt</span><span class="pt1">4–5 Ermahnung</span><span class="pt2">6–7 Verwarnung</span><span class="pt3">8 Führerschein weg</span>
    </div>
    <div class="grid cols2 note-mt">
      <div class="card">
        <h3><span>🗓️</span>Wann Punkte verfallen</h3>
        <div class="kv"><span class="lab">1 Punkt</span><span class="val">nach 2,5 Jahren</span></div>
        <div class="kv"><span class="lab">2 Punkte</span><span class="val">nach 5 Jahren</span></div>
        <div class="kv"><span class="lab">3 Punkte (Straftat mit Entzug)</span><span class="val">nach 10 Jahren</span></div>
      </div>
      <div class="card">
        <h3><span>🪪</span>Probezeit</h3>
        <div class="steps">
          <div><b>2 Jahre</b> ab dem ersten Führerschein</div>
          <div>1 schwerer (A) oder 2 leichtere (B) Verstöße → <b>Aufbauseminar + 2 Jahre länger</b></div>
          <div>noch einmal → <b>Verwarnung</b>, verkehrspsychologische Beratung empfohlen</div>
          <div>noch einmal → <b>Führerschein weg</b></div>
        </div>
      </div>
    </div>
  </Section>

  <Section id="licht" title="Licht und Wetter">
    <div class="grid cols3">
      <div class="card">
        <h3><span>🌫️</span>Nebelschlussleuchte</h3>
        <div class="kv"><span class="lab">nur bei</span><span class="val">Nebel + Sicht &lt; 50 m</span></div>
        <div class="kv"><span class="lab">dann max.</span><span class="val">50 km/h</span></div>
        <div class="tip">Nicht bei Regen oder Schnee, sonst blendet sie den Hintermann. Merke: <b>50 m Sicht, 50 km/h</b>.</div>
      </div>
      <div class="card">
        <h3><span>💡</span>Abblendlicht</h3>
        <div class="tip">Am Tag Pflicht bei Nebel, Schnee, Regen mit schlechter Sicht und im Tunnel. <b>Tagfahrlicht reicht dann nicht</b>. Kein Fernlicht bei Gegenverkehr oder dicht hinter jemandem.</div>
      </div>
      <div class="card">
        <h3><span>🌊</span>Aquaplaning</h3>
        <div class="tip">Fuß vorsichtig <b>vom Gas</b>, nicht bremsen, Lenkrad gerade halten, bis die Reifen wieder greifen.</div>
      </div>
      <div class="card">
        <h3><span>❄️</span>Winter</h3>
        <div class="kv"><span class="lab">Winterreifen</span><span class="val">Alpine-Symbol (Berg + Schneeflocke)</span></div>
        <div class="kv"><span class="lab">Pflicht</span><span class="val">bei Glatteis, Schneeglätte, Schneematsch, Eis- oder Reifglätte (situativ)</span></div>
        <div class="tip">Alle Scheiben frei machen, kein Guckloch. Brücken und Waldstücke frieren zuerst.</div>
      </div>
      <div class="card">
        <h3><span>🚨</span>Warnblinker</h3>
        <div class="tip">Stauende, Panne, Abschleppen, sehr langsames Fahren auf der Autobahn. Linienbus oder Schulbus blinkt an der Haltestelle: nur Schrittgeschwindigkeit vorbei. <b>Nicht</b> zum Falschparken.</div>
      </div>
      <div class="card">
        <h3><span>🚑</span>Rettungsgasse</h3>
        <div class="diag">
          <svg viewBox="0 0 300 90" role="img" aria-label="Rettungsgasse zwischen linker Spur und den übrigen Spuren">
            <rect x="0" y="0" width="300" height="90" fill="#c7ced6"/>
            <g fill="#1565d8"><rect x="12" y="8" width="26" height="40" rx="4"/><rect x="12" y="50" width="26" height="36" rx="4"/></g>
            <g fill="#d92f2f"><rect x="122" y="8" width="26" height="40" rx="4"/><rect x="122" y="50" width="26" height="36" rx="4"/><rect x="200" y="8" width="26" height="40" rx="4"/><rect x="200" y="50" width="26" height="36" rx="4"/></g>
            <path d="M80 10 V80" stroke="#f5a400" stroke-width="5" stroke-dasharray="8 6"/>
            <text x="80" y="50" font-size="11" font-weight="800" fill="#17171b" text-anchor="middle" transform="rotate(-90 80 50)" dy="-6">Gasse</text>
          </svg>
        </div>
        <p class="note">Linke Spur nach <b>links</b>, alle anderen nach <b>rechts</b>. Schon bei Schrittgeschwindigkeit bilden, auf Autobahn und außerorts ab 2 Spuren je Richtung. <b>Rechte-Hand-Regel: Daumen = linke Spur, Finger = der Rest.</b></p>
      </div>
    </div>
  </Section>

  <Section id="unfall" title="Unfall und Panne">
    <div class="flow">
      <div><b>1</b>Warnblinker</div>
      <div><b>2</b>Warnweste</div>
      <div><b>3</b>Warndreieck</div>
      <div><b>4</b>Erste Hilfe</div>
      <div><b>5</b>Rettungsdienst rufen (112)</div>
    </div>
    <p class="note note-mt"><b>Prüfungsantwort:</b> Absichern → Erste Hilfe → Rettungsdienst alarmieren. In echt: Notruf so früh wie möglich, am besten ruft ein zweiter Helfer an. Helfen ist Pflicht. Wer ohne Angaben wegfährt, begeht <b>Unfallflucht</b>. Notruf <b>112</b>, Polizei <b>110</b>.</p>

    <h3 class="sub-h">Warndreieck: wie weit zurück?</h3>
    <div class="ruler">
      <div class="rl"><span class="rl-m">50 m</span><span class="rl-bar"><span style="width:50%"></span></span><span class="rl-t">innerorts</span></div>
      <div class="rl"><span class="rl-m">100 m</span><span class="rl-bar"><span style="width:100%"></span></span><span class="rl-t">Landstraße und Autobahn (Prüfungsantwort)<small>auf der Autobahn in echt gern weiter, immer hinter der Leitplanke gehen</small></span></div>
    </div>
    <div class="tip note-mt"><b>Merksatz:</b> Leitpfosten stehen alle 50 m, also ca. <b>2 Pfosten</b> zurück (100 m).</div>
  </Section>

  <Section id="fahrzeug" title="Fahrzeug, Ladung, Anhänger">
    <div class="grid cols3">
      <div class="card">
        <h3><span>🛞</span>Reifen</h3>
        <div class="kv"><span class="lab">Mindestprofil</span><span class="val">1,6 mm</span></div>
        <div class="kv"><span class="lab">empfohlen</span><span class="val">Sommer 3 mm · Winter 4 mm</span></div>
        <div class="tip">Luftdruck bei <b>kalten</b> Reifen prüfen. Volle Beladung = mehr Druck.</div>
      </div>
      <div class="card">
        <h3><span>📦</span>Ladung</h3>
        <div class="kv"><span class="lab">nach hinten raus</span><span class="val">max. 1,5 m</span></div>
        <div class="kv"><span class="lab">bei Fahrt bis 100 km</span><span class="val">max. 3 m</span></div>
        <div class="kv"><span class="lab">kennzeichnen ab</span><span class="val">mehr als 1 m über die Rückstrahler</span></div>
        <div class="kv"><span class="lab">wie</span><span class="val">rote Fahne oder Schild mind. 30 × 30 cm, max. 1,5 m hoch; bei Dunkelheit zusätzlich rote Leuchte</span></div>
        <div class="kv"><span class="lab">nach vorn</span><span class="val">nichts, ab 2,5 m Höhe bis 50 cm</span></div>
        <div class="kv"><span class="lab">seitlich</span><span class="val">mehr als 40 cm über die Leuchten: bei Dunkelheit kennzeichnen</span></div>
        <div class="tip"><b>Merksatz:</b> ab <b>1</b> markieren, bis <b>1,5</b> raus, <b>3</b> nur unter 100 km.</div>
      </div>
      <div class="card">
        <h3><span>🚙</span>Klasse B darf</h3>
        <div class="kv"><span class="lab">Fahrzeug</span><span class="val">bis 3.500 kg</span></div>
        <div class="kv"><span class="lab">Anhänger</span><span class="val">bis 750 kg</span></div>
        <div class="kv"><span class="lab">schwerer Anhänger</span><span class="val">wenn Zug ≤ 3.500 kg</span></div>
        <div class="kv"><span class="lab">mit B96</span><span class="val">Zug bis 4.250 kg</span></div>
        <div class="kv"><span class="lab">Pkw + Anhänger</span><span class="val">1 Anhänger, max. 18 m lang</span></div>
        <div class="kv"><span class="lab">Mindestalter</span><span class="val">18 · begleitet ab 17</span></div>
      </div>
      <div class="card">
        <h3><span>🧒</span>Kinder</h3>
        <div class="kv"><span class="lab">Kindersitz bis</span><span class="val">unter 12 Jahre <b>und</b> unter 150 cm</span></div>
        <div class="tip">Rückwärts gerichteter Sitz auf dem Beifahrersitz nur mit <b>ausgeschaltetem</b> Airbag.</div>
      </div>
      <div class="card">
        <h3><span>📱</span>Handy</h3>
        <div class="tip">In die Hand nehmen nur, wenn das Auto steht <b>und</b> der Motor ganz aus ist. Start-Stopp-Automatik zählt <b>nicht</b>.</div>
      </div>
      <div class="card">
        <h3><span>🔧</span>Prüfungen und Pflichten</h3>
        <div class="kv"><span class="lab">HU (TÜV) Neuwagen</span><span class="val">nach 3 Jahren</span></div>
        <div class="kv"><span class="lab">danach</span><span class="val">alle 2 Jahre</span></div>
        <div class="kv"><span class="lab">dabeihaben</span><span class="val">Führerschein, Zulassung Teil I</span></div>
        <div class="kv"><span class="lab">im Auto</span><span class="val">Warndreieck, Weste, Verbandkasten</span></div>
        <div class="tip">Abschleppen: Seil max. <b>5 m</b>, kennzeichnen, beide Warnblinker. Autobahn an der nächsten Ausfahrt verlassen.</div>
      </div>
      <div class="card">
        <h3><span>🌱</span>Umweltbewusst fahren</h3>
        <div class="tip">Früh hochschalten (ca. 2.000 U/min), vorausschauend rollen lassen, Motor aus bei längerem Warten, Dachbox abbauen, Reifendruck prüfen. Unnützes Hin- und Herfahren ist <b>innerorts verboten</b>, wenn es andere stört.</div>
      </div>
    </div>
  </Section>



  <Section id="vorfahrt" title="Vorfahrt: oben schlägt unten">
    <div class="ladder">
      <div><span>1</span>👮 Polizei</div>
      <div><span>2</span>🚦 Ampel</div>
      <div><span>3</span>⛔ Schilder und Markierungen</div>
      <div><span>4</span>↔️ Rechts vor links</div>
    </div>
    <div class="tip note-mt"><b>Merksatz:</b> Polizei schlägt Ampel, Ampel schlägt Schild, Schild schlägt rechts vor links. Ampel aus oder gelb blinkend? Dann gelten die Schilder.</div>
  </Section>

  <Section title="Vorfahrt: die Klassiker">
    <div class="grid cols2">

      <div class="card">
        <h3><span>↔️</span>Rechts vor links</h3>
        <div class="diag">
          <svg viewBox="0 0 300 190" role="img" aria-label="Kreuzung ohne Schilder: das Auto von rechts fährt zuerst">
            <rect x="118" y="0" width="64" height="190" fill="#c7ced6"/>
            <rect x="0" y="70" width="300" height="64" fill="#c7ced6"/>
            <rect x="152" y="150" width="24" height="34" rx="5" fill="#d92f2f"/>
            <rect x="236" y="74" width="34" height="24" rx="5" fill="#1565d8"/>
            <text x="164" y="172" font-size="11" fill="#fff" text-anchor="middle" font-weight="800">DU</text>
            <text x="253" y="90" font-size="12" fill="#fff" text-anchor="middle" font-weight="800">1</text>
          </svg>
        </div>
        <p class="note">Keine Schilder, keine Ampel: <b>wer von rechts kommt, fährt zuerst.</b> Gilt auch in fast allen Tempo-30-Zonen.</p>
      </div>

      <div class="card">
        <h3><span>↩️</span>Links abbiegen</h3>
        <div class="diag">
          <svg viewBox="0 0 300 190" role="img" aria-label="Linksabbieger wartet auf Gegenverkehr">
            <rect x="118" y="0" width="64" height="190" fill="#c7ced6"/>
            <rect x="0" y="70" width="300" height="64" fill="#c7ced6"/>
            <rect x="124" y="6" width="22" height="32" rx="5" fill="#1565d8"/>
            <text x="135" y="27" font-size="12" fill="#fff" text-anchor="middle" font-weight="800">1</text>
            <rect x="154" y="150" width="22" height="32" rx="5" fill="#d92f2f"/>
            <path d="M165 150 q0 -32 -50 -32" fill="none" stroke="#d92f2f" stroke-width="3" stroke-dasharray="6 5"/>
            <text x="165" y="172" font-size="11" fill="#fff" text-anchor="middle" font-weight="800">DU</text>
          </svg>
        </div>
        <p class="note">Wer links abbiegt, lässt den <b>Gegenverkehr</b> und Fußgänger der Zielstraße zuerst. Kommen sich zwei Linksabbieger entgegen: <b>voreinander</b> abbiegen, außer Verkehr oder Bauart der Kreuzung verlangen, erst aneinander vorbeizufahren.</p>
      </div>

      <div class="card">
        <h3><span>🔄</span>Kreisverkehr</h3>
        <div class="diag">
          <svg viewBox="0 0 300 190" role="img" aria-label="Kreisverkehr: rein ohne Blinker, raus mit Blinker rechts">
            <circle cx="150" cy="95" r="70" fill="#c7ced6"/>
            <circle cx="150" cy="95" r="32" fill="#7fb77e"/>
            <rect x="130" y="160" width="40" height="30" fill="#c7ced6"/>
            <rect x="215" y="75" width="85" height="40" fill="#c7ced6"/>
            <rect x="150" y="160" width="20" height="28" rx="4" fill="#d92f2f"/>
            <text x="150" y="152" font-size="11" text-anchor="middle" font-weight="800" fill="var(--ink)">rein: kein Blinker</text>
            <circle cx="218" cy="103" r="5" fill="#f5a400"/>
            <text x="258" y="70" font-size="11" text-anchor="middle" font-weight="800" fill="var(--ink)">raus: rechts ▸</text>
            <path d="M160 145 A50 50 0 0 0 200 95" fill="none" stroke="#d92f2f" stroke-width="3" stroke-dasharray="6 5"/>
          </svg>
        </div>
        <p class="note">Mit Zeichen 215 + 205: <b>der Kreis hat Vorfahrt</b>. Beim Einfahren blinken ist <b>verboten</b>, beim Ausfahren <b>Pflicht</b>. Im Kreis nicht halten.</p>
      </div>

      <div class="card">
        <h3><span>↪️</span>Abknickende Vorfahrt</h3>
        <div class="diag">
          <svg viewBox="0 0 300 190" role="img" aria-label="Zusatztafel abknickende Vorfahrt: dicke Linie ist die Vorfahrtstraße">
            <rect x="105" y="10" width="90" height="170" rx="6" fill="#fff" stroke="#17171b" stroke-width="3"/>
            <path d="M150 170 V95 H112" stroke="#17171b" stroke-width="12" fill="none"/>
            <path d="M150 95 V22 M150 95 H188" stroke="#17171b" stroke-width="4" fill="none"/>
            <text x="235" y="80" font-size="11" font-weight="800" fill="var(--ink)">dick =</text>
            <text x="235" y="95" font-size="11" font-weight="800" fill="var(--ink)">Vorfahrt</text>
          </svg>
        </div>
        <p class="note">Die <b>dicke Linie</b> ist die Vorfahrtstraße. Folgst du dem Knick, behältst du Vorfahrt, musst aber <b>blinken</b>. Untereinander gilt auf den dünnen Ästen rechts vor links.</p>
      </div>

      <div class="card">
        <h3><span>🪢</span>Reißverschluss</h3>
        <div class="diag">
          <svg viewBox="0 0 300 120" role="img" aria-label="Reißverschluss: bis zum Ende der Spur fahren, dann abwechselnd einfädeln">
            <rect x="0" y="20" width="300" height="40" fill="#c7ced6"/>
            <path d="M0 60 H200 L240 60 L240 60 L200 100 H0 Z" fill="#c7ced6"/>
            <path d="M0 60 H200" stroke="#fff" stroke-width="2" stroke-dasharray="10 8"/>
            <rect x="40" y="28" width="30" height="22" rx="4" fill="#1565d8"/><rect x="110" y="28" width="30" height="22" rx="4" fill="#1565d8"/>
            <rect x="75" y="70" width="30" height="22" rx="4" fill="#d92f2f"/><rect x="150" y="70" width="30" height="22" rx="4" fill="#d92f2f"/>
            <path d="M182 80 Q205 78 220 50" stroke="#d92f2f" stroke-width="3" fill="none" stroke-dasharray="5 4"/>
            <text x="250" y="110" font-size="11" text-anchor="middle" font-weight="800" fill="var(--ink)">erst am Ende</text>
          </svg>
        </div>
        <p class="note">Endende Spur <b>bis zum Ende</b> nutzen, dann abwechselnd je ein Fahrzeug (§ 7 Abs. 4). Nicht zu früh wechseln.</p>
      </div>

      <div class="card">
        <h3><span>👮</span>Polizei-Zeichen</h3>
        <div class="diag">
          <svg viewBox="0 0 300 120" role="img" aria-label="Drei Haltungen des Polizisten">
            <g transform="translate(60,12)"><circle cx="0" cy="10" r="9" fill="var(--ink)"/><rect x="-7" y="21" width="14" height="34" rx="4" fill="var(--ink)"/><path d="M-7 26 H-34 M7 26 H34" stroke="var(--ink)" stroke-width="6"/><text x="0" y="78" font-size="11" text-anchor="middle" fill="var(--muted)" font-weight="700">1</text></g>
            <g transform="translate(150,12)"><circle cx="0" cy="10" r="9" fill="var(--ink)"/><rect x="-7" y="21" width="14" height="34" rx="4" fill="var(--ink)"/><path d="M0 21 L0 -6" stroke="var(--ink)" stroke-width="6"/><text x="0" y="78" font-size="11" text-anchor="middle" fill="var(--muted)" font-weight="700">2</text></g>
            <g transform="translate(240,12)"><circle cx="0" cy="10" r="9" fill="var(--ink)"/><rect x="-7" y="21" width="14" height="34" rx="4" fill="var(--ink)"/><path d="M7 26 L34 16" stroke="var(--ink)" stroke-width="6"/><text x="0" y="78" font-size="11" text-anchor="middle" fill="var(--muted)" font-weight="700">3</text></g>
          </svg>
        </div>
        <p class="note"><b>1</b> Brust oder Rücken zu dir: <b>Halt</b> (wie Rot). Seitlich: frei (wie Grün). <b>2</b> Arm hoch: vor der Kreuzung warten, wer schon drin ist, räumt die Kreuzung (<b>wie Gelb</b>). <b>3</b> Winken: diese Richtung fahren.</p>
      </div>
    </div>
  </Section>

  <Section title="Vorfahrt: immer warten">
    <div class="chips">
      <div>🏠 Aus <b>Grundstück</b>, Parkplatz, Fußgängerzone, verkehrsberuhigtem Bereich oder über abgesenkten Bordstein raus: <b>alle</b> haben Vorrang (§ 10). Aus Feld- oder Waldweg: keine Vorfahrt (§ 8)</div>
      <div>🚨 <b>Blaulicht + Martinshorn</b>: sofort freie Bahn schaffen</div>
      <div>🚌 Linienbus will von gekennzeichneter <b>Haltestelle</b> abfahren: abfahren lassen, notfalls warten</div>
      <div>🚊 <b>Straßenbahn</b>: normale Vorfahrtregeln, aber beim Abbiegen und neben dir in gleicher Richtung hat sie Vorrang</div>
      <div>🚶 Fußgänger am <b>Zebrastreifen</b> und beim Abbiegen in die Querstraße</div>
      <div>🚦 Stau hinter der Kreuzung: <b>nicht einfahren</b>, auch bei Grün</div>
    </div>
  </Section>

  <Section title="Grünpfeil">
    <div class="vs">
      <div><b>Grünpfeil-Schild</b> (Blech, § 37) neben Rot<br/><span class="big">STOPP</span>erst ganz anhalten, dann rechts abbiegen, nur aus dem rechten Fahrstreifen, niemanden behindern</div>
      <div><b>Leuchtender</b> grüner Pfeil in der Ampel<br/><span class="big go">FAHREN</span>normale freie Fahrt in Pfeilrichtung</div>
    </div>
  </Section>


  <Section id="vergessen" title="Oft verwechselt">
    <div class="pairs">
      {PAIRS.map(([a, at, b, bt]) => (
        <div class="pair">
          <div><img src={img(a)} alt="" width="56" height="56" loading="lazy" /><span set:html={at} /></div>
          <div><img src={img(b)} alt="" width="56" height="56" loading="lazy" /><span set:html={bt} /></div>
        </div>
      ))}
    </div>
  </Section>

  <Section title="Oft vergessen">
    <div class="chips">
      <div>🟡 <b>Gelbe</b> Baustellen-Markierung geht vor weißer</div>
      <div>🚦 <b>Rot + Gelb</b> = gleich Grün, aber noch <b>nicht</b> fahren. Gelb allein = anhalten, wenn es gefahrlos geht</div>
      <div>🦓 Am Zebrastreifen <b>nicht überholen</b> (§ 26)</div>
      <div>📯 Hupe und Lichthupe: bei Gefahr, außerorts auch zum <b>Ankündigen des Überholens</b></div>
      <div>🅿️ Links parken nur in der <b>Einbahnstraße</b> oder wenn rechts Schienen liegen</div>
      <div>🅿️ Auf dem Gehweg parken nur mit Zeichen 315 oder markierter Parkfläche</div>
      <div>🕐 Parkscheibe auf die <b>nächste halbe Stunde</b> vorstellen (10:05 → 10:30)</div>
      <div>🚒 Vor Feuerwehrzufahrten nicht halten. In zweiter Reihe nicht halten</div>
      <div>🚲 Bei „Verbot für Fahrzeuge aller Art“ (250) darf man Rad <b>schieben</b></div>
      <div>🌿 <b>Umweltzone</b>: nur mit (grüner) Plakette, sonst Bußgeld</div>
      <div>🚑 Blaulicht + Martinshorn: sofort freie Bahn. Blaulicht ohne Horn: Warnung vor Unfall- oder Einsatzstelle, Einsatzfahrt (Platz machen) oder geschlossener Verband</div>
      <div>❤️ Erste Hilfe: <b>30 × drücken, 2 × beatmen</b>, ca. 100–120 pro Minute</div>
      <div>🪪 Immer dabei: Führerschein + Zulassungsbescheinigung Teil I</div>
      <div>🔁 Probezeit: 2 Jahre, <b>0,0 ‰</b> und kein Cannabis, egal wie alt</div>
    </div>
  </Section>



  <Section id="verhalten" title="Oft gefragt: Verhalten und Technik">
    <div class="rules">
      <div class="card"><h3><span>🧒</span>Menschen am Straßenrand</h3><ul>
        <li><b>Ball rollt</b> auf die Straße: bremsen, nicht ausweichen. Ein Kind kommt hinterher</li>
        <li>Kinder auf dem Gehweg: <b>langsamer, bremsbereit</b>, nicht hupen</li>
        <li>Kind mit Hund: Hund reißt los, <b>Kind rennt hinterher</b></li>
        <li>Ältere Menschen <b>bleiben stehen oder drehen um</b> auf der Fahrbahn</li>
        <li>Weißer Stock, gelbe Binde mit 3 Punkten: langsamer, notfalls <b>anhalten</b>, nicht hupen</li>
        <li>Rollstuhl kommt nicht auf den Bordstein: anhalten, Warnblinker, <b>helfen</b></li>
        <li>Fußgänger durchlassen: anhalten. <b>Lichthupe als Einladung ist falsch</b></li>
      </ul></div>
      <div class="card"><h3><span>🚌</span>Bus und Straßenbahn</h3><ul>
        <li>Linien- oder Schulbus hält mit Warnblinker an der Haltestelle: <b>Schritttempo</b>, auch für den Gegenverkehr auf derselben Fahrbahn</li>
        <li>Bus fährt mit Warnblinker heran: <b>nicht überholen</b></li>
        <li>Straßenbahn-Haltestelle ohne Insel, Fahrgäste steigen ein oder aus: rechts nur <b>Schritttempo</b>, niemand gefährden oder behindern, sonst warten</li>
        <li>Fahrende Straßenbahn <b>rechts</b> überholen. Links nur in Einbahnstraße oder wenn Schienen zu weit rechts liegen</li>
      </ul></div>
      <div class="card"><h3><span>🚲</span>Rad, Reiter, Tiere</h3><ul>
        <li>Seitenabstand zum Rad: mindestens <b>1,5 m innerorts, 2 m außerorts</b>, mehr bei Kindern und Tempo. Nur 50 cm Platz: <b>nicht überholen</b></li>
        <li>Radfahrer am Berg <b>pendeln</b>: mehr Abstand</li>
        <li>Rechne mit Rädern in falscher Richtung, ohne Licht. <b>E-Bikes</b> sind schneller als gedacht</li>
        <li>Pferdekutsche: leise, viel Abstand, auf Handzeichen achten</li>
        <li>Wildwechsel vor allem in der <b>Dämmerung</b>. Nach einem Reh kommen oft weitere</li>
        <li>Wild im Licht: <b>abblenden, hupen, bremsen</b></li>
        <li>Unfall mit Wild unvermeidbar: voll bremsen, <b>Lenkrad gerade</b>. Merke: „Lieber Reh als Baum“</li>
        <li>Nach Wildunfall: absichern, Polizei oder Förster rufen, Tier nicht mitnehmen</li>
      </ul></div>
      <div class="card"><h3><span>🌫️</span>Sicht, Wetter, Kurven</h3><ul>
        <li>Geblendet: auf den <b>rechten Fahrbahnrand</b> schauen, langsamer. Nie selbst aufblenden</li>
        <li>Fernlicht darf an bleiben, wenn Fußgänger <b>in gleicher Richtung</b> vorausgehen (Falle)</li>
        <li>Nebelscheinwerfer auch bei Regen/Schnee. Nebelschlussleuchte <b>nur bei Nebel &lt; 50 m</b></li>
        <li>Im Nebel nicht auf der Mittellinie fahren. Nebel oft an Flüssen, Seen, Mooren</li>
        <li><b>Erster Regen</b> nach Trockenheit: Schmierfilm, sofort mehr Abstand</li>
        <li>Glätte testen: nur ganz langsam und wenn niemand hinter dir ist, kurz bremsen. Öl auf der Straße: Feuerwehr rufen</li>
        <li>Seitenwind: <b>gegenlenken</b>, langsamer. Brücken, Waldschneisen, Lkw überholen</li>
        <li>Kurve: <b>vorher bremsen</b>, erst am Ausgang Gas geben</li>
        <li>Zu viel Gas in der Kurve: <b>wo der Antrieb ist, rutscht es</b> (Front vorne, Heck hinten)</li>
        <li>Nach langer schneller Fahrt unterschätzt man das eigene Tempo</li>
      </ul></div>
      <div class="card"><h3><span>🛣️</span>Überholen, Spuren, Autobahn</h3><ul>
        <li>Du wirst überholt: <b>nicht schneller werden</b>, rechts halten</li>
        <li>Überholen abbrechen, wenn der andere beschleunigt oder Gegenverkehr kommt</li>
        <li>Lichthupe hinter dir beim Überholen: <b>zügig fertig überholen</b>, dann rechts. Nicht bremsen</li>
        <li>Rechts überholen auf der Autobahn nur, wenn links eine Schlange <b>steht oder langsam fährt</b>, dann nur etwas schneller und sehr vorsichtig</li>
        <li>Einfädeln: schneller sein ist ok, aber die <b>Autobahn hat Vorfahrt</b></li>
        <li>Ausfahrt verpasst: <b>bis zur nächsten</b> weiter. Nie zurück, nie halten</li>
        <li>Falsch eingeordnet: in <b>Pfeilrichtung</b> weiterfahren</li>
        <li>Stau: Kreuzung, Einmündung, Bahnübergang, Zebrastreifen <b>freihalten</b></li>
        <li>Geschlossener Verband (Polizei, Bundeswehr): durchlassen, auch bei Grün</li>
        <li>Abknickende Vorfahrt <b>geradeaus</b> verlassen: nicht blinken</li>
        <li>Wer Vorfahrt hat, verzichtet: erst fahren, wenn ihr euch <b>eindeutig verständigt</b> habt, z. B. per Handzeichen</li>
      </ul></div>
      <div class="card"><h3><span>🚂</span>Bahnübergang</h3><ul>
        <li>Rotes Blinklicht, Halbschranke noch offen: <b>warten</b></li>
        <li>Nach dem Zug erst fahren, wenn das <b>Blinklicht aus</b> ist</li>
        <li>Warten <b>vor dem Andreaskreuz</b>, nicht an der Schranke</li>
        <li>Schranke bewegt sich lange nicht: nicht queren, Polizei rufen</li>
        <li>Weiß-rot-weiße Fahne oder rote Leuchte eines Bahnmitarbeiters: warten</li>
      </ul></div>
      <div class="card"><h3><span>👮</span>Polizei, Unfall, Tunnel</h3><ul>
        <li>„STOP POLIZEI“ oder „BITTE FOLGEN“ gilt <b>nur für dich</b></li>
        <li>Rot überfahren nur, um einem Einsatzfahrzeug <b>vorsichtig Platz</b> zu machen oder auf Polizeizeichen</li>
        <li>Blaulicht + Horn: rechts ran, langsamer, <b>nicht sofort stehen bleiben</b></li>
        <li>Geparktes Auto beschädigt: warten, Namen und Anschrift hinterlassen, <b>Polizei informieren</b></li>
        <li>Schwarze Pfeile auf Leitpfosten zeigen zur nächsten <b>Notrufsäule</b></li>
        <li>Feuer im Tunnel: Warnblinker, Motor aus, <b>Schlüssel stecken lassen</b>, über Notausgang raus</li>
        <li>Orange Gefahrgut-Tafel: die <b>Zahlen beim Notruf</b> durchgeben</li>
      </ul></div>
      <div class="card"><h3><span>🔧</span>Technik und Assistenten</h3><ul>
        <li><b>ABS</b>: beim Bremsen lenkbar. Verhindert kein Aquaplaning, keine schnelleren Kurven</li>
        <li><b>ASR</b>: kein Durchdrehen beim Anfahren. <b>ESP</b> blinkt = zu schnell, leuchtet dauernd = aus oder defekt</li>
        <li>Spurhalteassistent braucht klare Linien. Übersteuern durch Lenken oder Blinker</li>
        <li>Abstandstempomat kann bei Regen/Schnee ausfallen. Tempomat übersteuern mit <b>Bremse oder Gas</b></li>
        <li>Assistenten gleichen <b>Müdigkeit nicht aus</b></li>
        <li>Kontrollleuchten: Fernlicht <b>blau</b>, Nebelschluss <b>gelb</b>. Öldruck bleibt an: <b>Motor sofort aus</b></li>
        <li>Blinker-Kontrolle blinkt <b>viel schneller als sonst</b>: eine Lampe ist kaputt</li>
        <li>Bremspedal geht bis zum Boden: <b>stehen lassen</b>. Bremsflüssigkeit wird gewechselt, weil sie Wasser zieht</li>
        <li>Langes Gefälle: <b>kleiner Gang</b>, nie Leerlauf oder getretene Kupplung</li>
        <li>Zu wenig Luft: Reifen wird heiß. Auto zieht nach links: evtl. vorne links zu wenig Luft</li>
        <li>Radwechsel: sichern, <b>Muttern lösen</b>, dann erst anheben. Später nachziehen</li>
        <li>Abschleppen mit Motorschaden: Bremse und Lenkung gehen <b>schwer</b>. Besser Abschleppstange</li>
      </ul></div>
      <div class="card"><h3><span>🪑</span>Sitzen und Sichern</h3><ul>
        <li>Kopfstütze: Oberkante etwa auf <b>Höhe Kopfoberkante</b>, nah am Hinterkopf</li>
        <li>Gurt straff, nicht verdreht, nie unter dem Arm. Dicke Winterjacke schwächt ihn</li>
        <li>Gurt auf allen Sitzen, <b>auch mit Airbag</b></li>
        <li>Kind 11 Jahre, 140 cm: <b>Sitzerhöhung</b> + Dreipunktgurt</li>
        <li>Gegen Wegrollen: Handbremse + <b>1. Gang oder Rückwärtsgang</b>. Automatik: Handbremse + <b>P</b></li>
      </ul></div>
      <div class="card"><h3><span>🌱</span>Umwelt</h3><ul>
        <li>Nach dem Start <b>sofort losfahren</b>, nicht warmlaufen lassen</li>
        <li>Motor aus an der <b>Bahnschranke</b>, nicht am Stoppschild</li>
        <li>Klimaanlage und Sitzheizung kosten Sprit. Luftwiderstand hängt vor allem vom <b>Tempo</b> ab</li>
        <li>Automatik: <b>Kickdown</b> vermeiden</li>
        <li>Umweltplakette innen an die Scheibe, gilt nur geklebt. Motorräder brauchen keine</li>
      </ul></div>
    </div>
  </Section>

  <div class="wrap part" id="teil-praxis"><h2>Praxis</h2><span>Was der Prüfer im Auto sehen will</span></div>

  <Section id="praxis" title="Praktische Prüfung in Zahlen">
    <div class="stats">
      <div class="stat"><b>55</b><span>Minuten gesamt</span></div>
      <div class="stat"><b>≥ 30</b><span>Minuten reine Fahrzeit</span></div>
      <div class="stat"><b>3</b><span>Grundfahraufgaben</span></div>
      <div class="stat"><b>5 · 4 · 3</b><span>Sonderfahrten vorher:<br/>Überland · Autobahn · Nacht<br/>je 45 Min</span></div>
    </div>
    <div class="chips note-mt">
      <div>👀 Vor dem Losfahren: Sitz, Kopfstütze, Spiegel, Gurt. Der Prüfer schaut zu.</div>
      <div>🗺️ Stadt, Landstraße und meist Autobahn oder Kraftfahrstraße</div>
      <div>🅰️ Prüfung im Automatik = nur Automatik. Ausnahme <b>B197</b>: mindestens 10 Schaltstunden à 45 Min + 15 Min Testfahrt in der Fahrschule, Eintrag binnen 1 Jahr</div>
      <div>🔧 <b>Abfahrtkontrolle</b> (Licht, Reifen, Flüssigkeiten) gehört nur zu C, C1, D, D1, T, nicht zu Klasse B</div>
    </div>
  </Section>

  <Section id="blick" title="Die Blickroutine">
    <div class="flow">
      <div><b>1</b>Innenspiegel</div>
      <div><b>2</b>Außenspiegel</div>
      <div><b>3</b>Blinker</div>
      <div><b>4</b>Schulterblick</div>
      <div><b>5</b>Fahren</div>
    </div>
    <div class="grid cols2 note-mt">
      <div class="card">
        <h3><span>👀</span>Der tote Winkel</h3>
        <div class="diag">
          <svg viewBox="0 0 300 150" role="img" aria-label="Toter Winkel links und rechts hinter dem Auto">
            <path d="M150 75 L20 20 L20 60 Z" fill="#f5a400" opacity=".55"/>
            <path d="M150 75 L280 20 L280 60 Z" fill="#f5a400" opacity=".55" transform="translate(0,0)"/>
            <path d="M120 70 L10 120 L60 140 Z" fill="#d92f2f" opacity=".55"/>
            <path d="M180 70 L290 120 L240 140 Z" fill="#d92f2f" opacity=".55"/>
            <rect x="125" y="20" width="50" height="90" rx="10" fill="#1565d8"/>
            <text x="150" y="70" font-size="11" fill="#fff" text-anchor="middle" font-weight="800">DU</text>
            <text x="45" y="148" font-size="11" fill="var(--ink)" font-weight="800">toter Winkel</text>
            <text x="200" y="148" font-size="11" fill="var(--ink)" font-weight="800">toter Winkel</text>
          </svg>
        </div>
        <p class="note">Gelb = siehst du im Spiegel. Rot = kein Spiegel zeigt es. Nur der <b>Schulterblick</b> (Kopf drehen, nicht nur Augen) deckt das ab.</p>
      </div>
      <div class="card">
        <h3><span>📋</span>Wann Schulterblick?</h3>
        <div class="steps">
          <div>Anfahren vom Fahrbahnrand: <b>links</b></div>
          <div>Spurwechsel und Einfädeln: zur <b>Zielseite</b></div>
          <div>Rechts abbiegen: <b>rechts</b> (Radweg!), kurz vor dem Abbiegen noch einmal</div>
          <div>Links abbiegen: <b>links</b>, kurz vor dem Abbiegen noch einmal</div>
          <div>Tür öffnen: Spiegel + Schulterblick (oder <b>holländischer Griff</b>: Tür mit der rechten Hand öffnen)</div>
        </div>
        <div class="tip">Kopf ca. <b>45°</b> drehen. Der Prüfer sieht nur deinen Kopf. Bewegt er sich nicht, hat der Blick nicht stattgefunden.</div>
      </div>
    </div>
  </Section>

  <Section id="aufgaben" title="Grundfahraufgaben">
    <p class="note note-mb">Du fährst <b>3</b>: eine aus Gruppe A und zwei aus Gruppe B. Der Prüfer wählt aus.</p>
    <div class="grid cols2">
      <div class="card">
        <h3><span>🅰️</span>Rückwärts längs einparken</h3>
        <div class="diag">
          <svg viewBox="0 0 320 150" role="img" aria-label="Längs einparken in drei Schritten">
            <rect x="0" y="0" width="320" height="150" fill="#c7ced6"/>
            <rect x="0" y="100" width="320" height="50" fill="#9aa3ad"/>
            <rect x="10" y="102" width="70" height="34" rx="6" fill="#62626b"/>
            <rect x="230" y="102" width="70" height="34" rx="6" fill="#62626b"/>
            <rect x="225" y="50" width="70" height="34" rx="6" fill="#1565d8" opacity=".35"/>
            <text x="260" y="44" font-size="11" text-anchor="middle" font-weight="800" fill="#17171b">1</text>
            <rect x="160" y="68" width="70" height="34" rx="6" fill="#1565d8" opacity=".6" transform="rotate(-30 195 85)"/>
            <text x="180" y="54" font-size="11" text-anchor="middle" font-weight="800" fill="#17171b">2</text>
            <rect x="110" y="104" width="70" height="34" rx="6" fill="#1565d8"/>
            <text x="145" y="126" font-size="11" text-anchor="middle" font-weight="800" fill="#fff">3</text>
            <path d="M260 92 C230 100 200 110 160 120" stroke="#d92f2f" stroke-width="3" fill="none" stroke-dasharray="6 5"/>
          </svg>
        </div>
        <div class="steps">
          <div>Blinker rechts. Neben das vordere Auto, <b>0,5–1 m</b> seitlich, Heck auf einer Höhe</div>
          <div>Spiegel + Schulterblick, langsam zurückrollen</div>
          <div>Dein Hinterrad auf Höhe seines Hecks: <b>voll rechts</b></div>
          <div>Ca. <b>45°</b>, hinteres Auto ganz im linken Spiegel: Räder gerade</div>
          <div>Vorderes Eck frei: <b>voll links</b>, dann gerade stellen</div>
          <div>Parallel stehen, höchstens <b>30 cm</b> zum Bordstein</div>
        </div>
        <p class="note"><b>Prüfer will:</b> Lücke ca. <b>8 m</b>, höchstens <b>2 Korrekturzüge</b>, parallel, max. 30 cm.<br/><b>Fehler:</b> Bordstein berührt, schräg, zu weit weg, andere zugeparkt, zu wenig geschaut.</p>
        <div class="tip"><b>Merke:</b> „Heck an Heck, rechts, gerade, links.“</div>
      </div>

      <div class="card">
        <h3><span>🅰️</span>Rückwärts um die Ecke (rechts)</h3>
        <div class="diag">
          <svg viewBox="0 0 320 150" role="img" aria-label="Rückwärts nach rechts in eine Einmündung fahren">
            <rect x="0" y="0" width="320" height="70" fill="#c7ced6"/>
            <rect x="200" y="70" width="70" height="80" fill="#c7ced6"/>
            <path d="M200 70 Q200 70 200 70" stroke="#17171b"/>
            <rect x="70" y="40" width="70" height="28" rx="6" fill="#1565d8" opacity=".4"/>
            <rect x="205" y="100" width="28" height="50" rx="6" fill="#1565d8"/>
            <path d="M140 54 Q215 54 219 100" stroke="#d92f2f" stroke-width="3" fill="none" stroke-dasharray="6 5"/>
            <text x="100" y="30" font-size="11" font-weight="800" fill="#17171b" text-anchor="middle">Start</text>
          </svg>
        </div>
        <div class="steps">
          <div>An der Ecke vorbei, ca. <b>1 m</b> zum Bordstein, ca. 1 Autolänge nach der Ecke halten. Blinker rechts</div>
          <div>Rundum schauen: Innenspiegel, beide Außenspiegel, Schulterblick</div>
          <div>Schritttempo zurück. Hinterrad am Beginn der Kurve: <b>rechts einlenken</b></div>
          <div>Bordstein im rechten Spiegel <b>immer an der gleichen Stelle</b> halten</div>
          <div>Immer wieder nach links schauen: die Front schwenkt aus</div>
          <div>Gerade stellen, parallel anhalten</div>
        </div>
        <p class="note"><b>Prüfer will:</b> möglichst <b>enger Bogen</b>, rechts halten, Endstellung rückwärts und parallel, höchstens 2 Korrekturzüge.<br/><b>Fehler:</b> Bogen zu weit, Bordstein berührt, schräg. Fußgänger haben Vorrang.</p>
        <div class="tip"><b>Merke:</b> „Bordstein klebt im Spiegel.“</div>
      </div>

      <div class="card">
        <h3><span>🅱️</span>Umkehren</h3>
        <div class="diag">
          <svg viewBox="0 0 320 130" role="img" aria-label="Wenden in drei Zügen">
            <rect x="0" y="10" width="320" height="110" fill="#c7ced6"/>
            <path d="M0 65 H320" stroke="#fff" stroke-width="2" stroke-dasharray="10 8"/>
            <path d="M60 95 Q150 95 170 25" stroke="#1565d8" stroke-width="3" fill="none"/><text x="175" y="22" font-size="12" font-weight="800" fill="#17171b">1 vor</text>
            <path d="M170 25 Q160 95 230 100" stroke="#d92f2f" stroke-width="3" fill="none" stroke-dasharray="6 5"/><text x="232" y="112" font-size="12" font-weight="800" fill="#17171b">2 zurück</text>
            <path d="M230 100 Q160 40 60 40" stroke="#00a86b" stroke-width="3" fill="none"/><text x="20" y="34" font-size="12" font-weight="800" fill="#17171b">3 vor</text>
          </svg>
        </div>
        <div class="steps">
          <div>Ort und Art <b>wählst du selbst</b>: Einfahrt, Einmündung, Parkplatz oder Wenden in 3 Zügen</div>
          <div>Blinker, Spiegel, Schulterblick</div>
          <div>Vor <b>jedem</b> Zug rundum schauen, dann fahren. Lenken im <b>Rollen</b></div>
          <div>Vor dem Anhalten schon in die andere Richtung lenken</div>
          <div>Am Ende wieder auf der rechten Seite</div>
        </div>
        <p class="note"><b>Prüfer will:</b> keine Grenze bei der Anzahl der Züge.<br/><b>Fehler:</b> zu wenig Beobachtung, Rechtsfahrgebot nicht beachtet.</p>
        <div class="tip"><b>Merke:</b> „Jeder Zug: erst schauen.“</div>
      </div>

      <div class="card">
        <h3><span>🅱️</span>Quer oder schräg einparken</h3>
        <div class="diag">
          <svg viewBox="0 0 320 130" role="img" aria-label="Rückwärts quer einparken">
            <rect x="0" y="0" width="320" height="130" fill="#c7ced6"/>
            <g stroke="#fff" stroke-width="3"><path d="M60 70 V130 M120 70 V130 M180 70 V130 M240 70 V130"/></g>
            <rect x="62" y="74" width="54" height="52" rx="6" fill="#62626b"/><rect x="182" y="74" width="54" height="52" rx="6" fill="#62626b"/>
            <rect x="200" y="15" width="70" height="30" rx="6" fill="#1565d8" opacity=".4"/>
            <rect x="133" y="78" width="34" height="50" rx="6" fill="#1565d8"/>
            <path d="M200 30 Q150 30 150 78" stroke="#d92f2f" stroke-width="3" fill="none" stroke-dasharray="6 5"/>
          </svg>
        </div>
        <div class="vs">
          <div><b>Vorwärts</b>
        <div class="steps">
          <div>Mit <b>1,5–2 m</b> Abstand vorbei, Blinker</div>
          <div>Spiegel auf Höhe der ersten Linie: <b>voll einschlagen</b></div>
          <div>Ecken der Nachbarautos in beiden Spiegeln</div>
          <div>Linien parallel: gerade, anhalten</div>
        </div>
          </div>
          <div><b>Rückwärts</b>
        <div class="steps">
          <div>Mit ca. <b>1 m</b> vorbei. Schulter auf Höhe der Linie <b>nach</b> der Lücke: halten</div>
          <div>Spiegel + Schulterblick, voll einschlagen, langsam zurück</div>
          <div>Linien in beiden Spiegeln <b>parallel</b>: gerade</div>
          <div>Halten, wenn die Front in der Markierung ist</div>
        </div>
          </div>
        </div>
        <p class="note"><b>Prüfer will:</b> Vorwärts oder rückwärts. Ganz in der Markierung, genug Seitenabstand, höchstens 2 Korrekturzüge.<br/><b>Fehler:</b> Auto steht über die Markierung, zu wenig Seitenabstand.</p>
        <div class="tip"><b>Merke:</b> „Linien parallel = gerade.“</div>
      </div>

      <div class="card">
        <h3><span>🅱️</span>Gefahrbremsung</h3>
        <div class="flow small">
          <div><b>1</b>mind. 30 km/h, gerade</div>
          <div><b>2</b>Kommando vom Fahrlehrer</div>
          <div><b>3</b>Bremse + Kupplung schlagartig voll</div>
          <div><b>4</b>Druck halten bis Stillstand</div>
        </div>
        <p class="note"><b>Prüfer will:</b> Spur gerade halten, mit ABS voll draufbleiben (Rattern ist normal). Nach hinten schauen musst du nicht, das macht der Fahrlehrer.<br/><b>Fehler:</b> unter 30 km/h, zu schwach oder nicht schlagartig gebremst, Motor abgewürgt, aus der Spur gelenkt.</p>
        <div class="tip"><b>Merke:</b> „Beide Füße, voll, bis Stillstand.“</div>
      </div>
    </div>
  </Section>

  <Section id="fahren" title="Fahrtechnik">
    <div class="grid cols3">
      <div class="card">
        <h3><span>⚙️</span>Schalten</h3>
        <div class="gears">
          <span><b>1</b>Anfahren</span><span><b>2</b>bis ~20</span><span><b>3</b>~20–40</span><span><b>4</b>~40–60</span><span><b>5/6</b>ab ~60</span>
        </div>
        <div class="tip">Früh hochschalten (~2.000 U/min). Falscher Gang oder zu hohe Drehzahl ist ein Prüfungsfehler. <b>Vor</b> der Kurve bremsen und schalten, nicht in ihr. Nie im Leerlauf rollen.</div>
      </div>
      <div class="card">
        <h3><span>🦶</span>Anfahren am Berg</h3>
        <div class="flow small">
          <div><b>1</b>Handbremse an</div>
          <div><b>2</b>Schleifpunkt</div>
          <div><b>3</b>etwas Gas</div>
          <div><b>4</b>Handbremse lösen</div>
        </div>
        <div class="tip">Abgewürgt? Kupplung treten, neu starten, durchatmen. Zählt als <b>leichter Fehler</b>. Mehr als <b>50 cm</b> zurückrollen ist ein schwerer Fehler.</div>
      </div>
      <div class="card">
        <h3><span>↪️</span>Abbiegen in 8 Schritten</h3>
        <div class="steps">
          <div>Spiegel</div><div>Blinken</div><div>Einordnen</div><div>Tempo raus, Gang wählen</div>
          <div>Vorfahrt beachten</div><div><b>Zweiter Blick</b> (rechts: Radfahrer!)</div>
          <div>Fußgänger der Zielstraße</div><div>Rechts <b>eng</b>, links <b>weit</b></div>
        </div>
      </div>
      <div class="card">
        <h3><span>🛣️</span>Autobahn</h3>
        <div class="tip">Beschleunigungsstreifen <b>ganz</b> nutzen und Tempo angleichen. Erst auf dem Verzögerungsstreifen bremsen. Rechtsfahrgebot. Kein Halten, Wenden, Rückwärtsfahren.</div>
      </div>
      <div class="card">
        <h3><span>🗣️</span>Ansagen hilft</h3>
        <div class="tip">„Ich lasse den Radfahrer durch.“ Zeigt dem Prüfer, dass du die Situation siehst.</div>
      </div>
      <div class="card">
        <h3><span>😌</span>Nach einem Fehler</h3>
        <div class="tip">Weiterfahren, sicher bleiben. Ein kleiner Fehler heißt fast nie durchgefallen. Im Zweifel die sichere Option.</div>
      </div>
    </div>
  </Section>

  <Section id="situationen" title="Fahraufgaben im Verkehr">
    <div class="rules">
      <div class="card"><h3><span>🚦</span>Anfahren vom Rand</h3>
        <div class="steps">
          <div>Blinker links</div>
          <div>Spiegel, <b>Schulterblick links</b></div>
          <div>Lücke nutzen, Blinker aus</div>
        </div>
        <p class="note">Muss ein anderer deinetwegen stark bremsen = sofort durch.</p>
      </div>
      <div class="card"><h3><span>🏠</span>Aus Einfahrt oder Parkplatz</h3>
        <div class="steps">
          <div>Langsam vortasten</div>
          <div><b>Allen</b> Vorrang geben (§ 10)</div>
          <div>Wenn nötig, einweisen lassen</div>
        </div>
      </div>
      <div class="card"><h3><span>↔️</span>Fahrstreifenwechsel</h3>
        <div class="steps">
          <div>Nötig und erlaubt?</div>
          <div>Spiegel, Blinker, <b>Schulterblick</b></div>
          <div>Tempo anpassen, wechseln, Blinker aus</div>
        </div>
      </div>
      <div class="card"><h3><span>🛣️</span>Auf die Autobahn</h3>
        <div class="steps">
          <div>Früh auf die Hauptfahrbahn schauen</div>
          <div>Einfädelungsstreifen <b>weit nutzen</b>, Tempo angleichen</div>
          <div>Schulterblick links, einfädeln</div>
        </div>
        <p class="note">Mit unter 80 km/h einfädeln, wo 100 erlaubt ist und der Streifen lang genug ist = schwerer Fehler. Möglichst nicht anhalten, nur ohne Lücke am Ende des Streifens warten.</p>
      </div>
      <div class="card"><h3><span>🚪</span>Von der Autobahn</h3>
        <div class="steps">
          <div>Früh blinken, früh rüber</div>
          <div>Erst auf dem <b>Ausfädelungsstreifen</b> bremsen</div>
          <div>Tacho prüfen: du bist schneller, als es sich anfühlt</div>
        </div>
      </div>
      <div class="card"><h3><span>🚗</span>Überholen</h3>
        <div class="steps">
          <div>Erlaubt? Freie Sicht?</div>
          <div>Spiegel, Blinker, Schulterblick, ausscheren</div>
          <div>Rad: 1,5 m innerorts, 2 m außerorts</div>
          <div>Blinker rechts, einscheren, Blinker aus</div>
        </div>
      </div>
      <div class="card"><h3><span>🚧</span>Engstelle</h3>
        <div class="steps">
          <div>Hindernis auf <b>deiner</b> Seite: Gegenverkehr zuerst (§ 6)</div>
          <div>Spiegel, evtl. Blinker, Schulterblick</div>
          <div>Vorbei mit mind. 1 m Abstand bei 50</div>
        </div>
      </div>
      <div class="card"><h3><span>🔄</span>Kreisverkehr</h3>
        <div class="steps">
          <div>Rein <b>ohne</b> Blinker</div>
          <div>Kreis hat Vorfahrt (mit Zeichen 205)</div>
          <div>Vor deiner Ausfahrt rechts blinken, <b>Schulterblick rechts</b> (Radfahrer)</div>
        </div>
      </div>
      <div class="card"><h3><span>🚂</span>Bahnübergang</h3>
        <div class="steps">
          <div>Ab erster Bake nicht überholen</div>
          <div>Gleise links und rechts prüfen</div>
          <div>Vor dem Andreaskreuz warten</div>
          <div>Nur fahren, wenn hinter den Schienen Platz ist</div>
        </div>
      </div>
      <div class="card"><h3><span>🦓</span>Zebrastreifen und Bus</h3>
        <div class="steps">
          <div>Nicht überholen am Zebrastreifen</div>
          <div>Fußgänger will rüber: langsam ran, <b>anhalten</b></div>
          <div>Bus fährt mit Warnblinker an die Haltestelle: <b>nicht überholen</b>. Bus hält mit Warnblinker: nur <b>Schritttempo</b>, auch im Gegenverkehr</div>
        </div>
      </div>
    </div>
  </Section>

  <Section id="sichern" title="Auto sichern und bedienen">
    <div class="grid cols2">
      <div class="card">
        <h3><span>⛰️</span>Am Berg parken</h3>
        <div class="kv"><span class="lab">bergauf</span><span class="val">1. Gang + Handbremse</span></div>
        <div class="kv"><span class="lab">bergab</span><span class="val">Rückwärtsgang + Handbremse</span></div>
        <div class="kv"><span class="lab">Automatik</span><span class="val">erst Handbremse, dann P</span></div>
        <div class="kv"><span class="lab">bergab mit Bordstein</span><span class="val">Räder zum Bordstein</span></div>
        <div class="kv"><span class="lab">bergauf mit Bordstein</span><span class="val">Räder vom Bordstein weg</span></div>
        <div class="tip"><b>Merke:</b> „Gang gegen die Rollrichtung.“</div>
      </div>
      <div class="card">
        <h3><span>🔑</span>Auto verlassen und Prüfungsende</h3>
        <div class="steps">
          <div>Richtig parken</div>
          <div>Gegen Wegrollen sichern: Gang und Handbremse, oder P</div>
          <div>Schlüssel ab, Lenkradschloss, abschließen (§ 14: gegen unbefugte Benutzung)</div>
          <div>Vor und beim Türöffnen auf Verkehr achten, niemanden gefährden</div>
        </div>
        <p class="note">Nach einer Panne: sofort Warnblinker, dann Warndreieck (§ 15).</p>
      </div>
      <div class="card">
        <h3><span>🎛️</span>Bedienelemente im Griff</h3>
        <p class="note">In der Prüfung musst du Licht, Wischer und Waschanlage, Heizung, Lüftung und Heckscheibenheizung <b>selbst richtig</b> nutzen. <b>Licht oder Wischer</b> gar nicht nutzen, wenn es nötig wäre = schwerer Fehler.</p>
        <div class="tip"><b>Beschlagene Scheibe:</b> Gebläse auf die Frontscheibe, stärker stellen, Klima an, Heckscheibenheizung an.</div>
      </div>
      <div class="card">
        <h3><span>🔧</span>Falls der Prüfer Technik fragt</h3>
        <p class="note">Offiziell gibt es für Klasse B keine Pflicht-Technikfragen mehr. Manche Prüfer fragen trotzdem.</p>
        <div class="kv"><span class="lab">Ölstand</span><span class="val">Messstab, zwischen min und max, Motor aus, Auto eben</span></div>
        <div class="kv"><span class="lab">Kühlmittel</span><span class="val">Ausgleichsbehälter, min/max, nur kalt öffnen</span></div>
        <div class="kv"><span class="lab">Bremsflüssigkeit</span><span class="val">Behälter, zwischen min und max</span></div>
        <div class="kv"><span class="lab">Wischwasser</span><span class="val">Behälter mit Scheiben-Symbol</span></div>
        <div class="kv"><span class="lab">Reifendruck</span><span class="val">Aufkleber in Tür oder Tankklappe, kalt prüfen</span></div>
        <div class="kv"><span class="lab">Profil</span><span class="val">mind. 1,6 mm, TWI-Stege im Profil</span></div>
        <div class="kv"><span class="lab">Licht</span><span class="val">rundum gehen; Bremslicht mit Helfer oder Spiegelung</span></div>
      </div>
    </div>
  </Section>

  <Section id="fehler" title="Sofort durchgefallen">
    <div class="fails">
      <div><b>Vorfahrt oder Vorrang</b> missachtet (auch beim Anfahren vom Rand)</div>
      <div><b>Rot</b> oder ein Vorschriftzeichen missachtet, z. B. bei Stopp nicht angehalten</div>
      <div><b>Tempo:</b> innerorts mehr als 5, außerorts mehr als 10 km/h zu schnell und nicht in 3 s korrigiert</div>
      <div>Überholen bei <b>unklarer Lage</b>, oder schneller werden, während du überholt wirst</div>
      <div>Auf den <b>Schienen</b> halten, falsch herum im <b>Kreisverkehr</b></div>
      <div><b>Bus</b> überholen, der mit Warnblinker an die Haltestelle heranfährt, oder am haltenden Bus deutlich schneller als Schritttempo vorbei</div>
      <div><b>Überholverbot</b> missachtet (auch am Zebrastreifen), grundlos auf der Gegenfahrbahn, falscher Pfeil-Fahrstreifen</div>
      <div><b>Abstand</b> unter 1/4 Tacho ohne Korrektur, andere blenden</div>
      <div>Verkehr <b>gar nicht beobachtet</b>, vermeidbar von der Fahrbahn abgekommen</div>
      <div>Fahrlehrer oder Prüfer muss <b>eingreifen</b>, um eine Gefahr zu verhindern</div>
    </div>
    <p class="note note-mt">Viele kleine Fehler (z. B. Schulterblick mehrmals vergessen) können zusammen auch zum Nichtbestehen führen. Bewertet werden 5 Bereiche: <b>Verkehrsbeobachtung, Fahrzeugpositionierung, Geschwindigkeit, Kommunikation, Fahrzeugbedienung und umweltbewusstes Fahren</b>.</p>
  </Section>


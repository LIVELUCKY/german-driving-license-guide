---
// Self-test: formula drill (generated) and flashcards from the numeric catalogue questions.
import ZAHLEN from '../data/zahlenfragen.json';
const cards = ZAHLEN.flatMap(g => g.rows.map(r => ({ q: r.q, a: r.a, n: r.n })));
---
<div class="quiz" id="quiz">
  <div class="quiz-modes" role="group" aria-label="Was willst du üben?">
    <button type="button" data-mode="formel" aria-pressed="true">Formeln rechnen</button>
    <button type="button" data-mode="zahlen" aria-pressed="false">Zahlenfragen ({cards.length})</button>
  </div>
  <div class="quiz-card">
    <p class="quiz-q" id="quizQ">Lädt …</p>
    <div class="quiz-a" id="quizA" aria-live="polite" hidden></div>
    <div class="quiz-actions">
      <button type="button" class="quiz-show" id="quizShow">Antwort zeigen</button>
      <button type="button" class="quiz-ok" id="quizOk" hidden>✓ Gewusst</button>
      <button type="button" class="quiz-no" id="quizNo" hidden>✗ Nochmal</button>
    </div>
  </div>
  <p class="quiz-score" id="quizScore"></p>
</div>

<script is:inline define:vars={{ cards }}>
(function(){
  var de = function(x){ return String(Math.round(x * 10) / 10).replace('.', ','); };
  var pick = function(a){ return a[Math.floor(Math.random() * a.length)]; };
  var speeds = [30, 40, 50, 60, 70, 80, 90, 100, 110, 120, 130];

  // Each generator returns a question and the worked answer, using the formulas taught on this page.
  var FORMULAS = [
    function(v){ var t=v/10; return { q:'Reaktionsweg bei <b>'+v+' km/h</b>?', a:'('+v+' ÷ 10) × 3 = '+t+' × 3 = <b>'+de(t*3)+' m</b>' }; },
    function(v){ var t=v/10; return { q:'Normaler Bremsweg bei <b>'+v+' km/h</b>?', a:'('+v+' ÷ 10)² = '+t+' × '+t+' = <b>'+de(t*t)+' m</b>' }; },
    function(v){ var t=v/10; return { q:'Bremsweg bei <b>Gefahrbremsung</b>, '+v+' km/h?', a:'('+t+' × '+t+') ÷ 2 = <b>'+de(t*t/2)+' m</b>' }; },
    function(v){ var t=v/10; return { q:'Anhalteweg bei <b>'+v+' km/h</b>?', a:'Reaktion '+de(t*3)+' + Bremsen '+de(t*t)+' = <b>'+de(t*3+t*t)+' m</b>' }; },
    function(v){ var t=v/10; return { q:'Anhalteweg bei <b>Gefahr</b>, '+v+' km/h?', a:'Reaktion '+de(t*3)+' + halber Bremsweg '+de(t*t/2)+' = <b>'+de(t*3+t*t/2)+' m</b>' }; },
    function(v){ return { q:'Sicherheitsabstand außerorts bei <b>'+v+' km/h</b>?', a:'halber Tacho: '+v+' ÷ 2 = <b>'+de(v/2)+' m</b>' }; },
    function(){ var v=pick([30,40,50,60]), t=v/10; return { q:'Bremsweg bei '+v+' km/h = '+de(t*t)+' m. Wie lang bei <b>'+(2*v)+' km/h</b>?', a:'doppeltes Tempo = 4-facher Bremsweg: '+de(t*t)+' × 4 = <b>'+de(4*t*t)+' m</b>' }; },
    function(v){ var t=v/10; return { q:'Reaktionsweg bei '+v+' km/h mit <b>2 Sekunden</b> Reaktionszeit?', a:'('+v+' ÷ 10) × 3 × 2 = <b>'+de(t*6)+' m</b>' }; },
  ];

  var mode, deck, cur, ok, no;
  function el(id){ return document.getElementById(id); }
  function shuffle(a){ for (var i=a.length-1;i>0;i--){ var j=Math.floor(Math.random()*(i+1)); var x=a[i]; a[i]=a[j]; a[j]=x; } return a; }

  function next(){
    if (mode === 'formel') cur = pick(FORMULAS)(pick(speeds));
    else {
      if (!deck.length) { el('quizQ').innerHTML = '🎉 Alle Zahlenfragen durch!'; el('quizA').hidden = true; el('quizShow').hidden = false; el('quizShow').textContent = 'Nochmal von vorn'; cur = null; score(); return; }
      var c = deck[0]; cur = { q: c.q, a: c.a + ' <small>(' + c.n + ')</small>', card: c };
    }
    el('quizQ').innerHTML = cur.q;
    el('quizA').innerHTML = cur.a; el('quizA').hidden = true;
    el('quizShow').hidden = false; el('quizShow').textContent = 'Antwort zeigen';
    el('quizOk').hidden = true; el('quizNo').hidden = true;
    score();
  }
  function score(){
    var left = mode === 'zahlen' ? ' · noch ' + deck.length + ' offen' : '';
    el('quizScore').textContent = (ok + no) ? ('✓ ' + ok + ' gewusst · ✗ ' + no + ' nochmal' + left) : (mode === 'zahlen' ? deck.length + ' Karten, zufällig gemischt' : 'Zufällige Tempos, unendlich viele Aufgaben');
  }
  function start(m){
    mode = m; ok = 0; no = 0; deck = m === 'zahlen' ? shuffle(cards.slice()) : [];
    document.querySelectorAll('.quiz-modes button').forEach(function(b){ b.setAttribute('aria-pressed', String(b.dataset.mode === m)); });
    next();
  }
  function answer(knew){
    if (knew) ok++; else no++;
    if (mode === 'zahlen') {
      var c = deck.shift();
      // Missed cards come back a few cards later.
      if (!knew) deck.splice(Math.min(3, deck.length), 0, c);
    }
    next();
  }
  function init(){
    var root = el('quiz'); if (!root || root.dataset.init) return; root.dataset.init = '1';
    root.querySelectorAll('.quiz-modes button').forEach(function(b){ b.addEventListener('click', function(){ start(b.dataset.mode); }); });
    el('quizShow').addEventListener('click', function(){
      if (!cur) { start('zahlen'); return; }
      el('quizA').hidden = false; el('quizShow').hidden = true; el('quizOk').hidden = false; el('quizNo').hidden = false; el('quizOk').focus();
    });
    el('quizOk').addEventListener('click', function(){ answer(true); });
    el('quizNo').addEventListener('click', function(){ answer(false); });
    start('formel');
  }
  document.addEventListener('astro:page-load', init);
  if (document.readyState !== 'loading') init();
})();
</script>

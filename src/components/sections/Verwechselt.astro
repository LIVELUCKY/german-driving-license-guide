---
import Section from '../Section.astro';
import { img, PAIRS } from '../../data/cheatsheet';

const FORGOTTEN = [
  '🟡 <b>Gelbe</b> Baustellen-Markierung geht vor weißer',
  '🚦 <b>Rot + Gelb</b> = gleich Grün, aber noch <b>nicht</b> fahren. Gelb allein = anhalten, wenn es gefahrlos geht',
  '🦓 Am Zebrastreifen <b>nicht überholen</b> (§ 26)',
  '📯 Hupe und Lichthupe: bei Gefahr, außerorts auch zum <b>Ankündigen des Überholens</b>',
  '🅿️ Links parken nur in der <b>Einbahnstraße</b> oder wenn rechts Schienen liegen',
  '🅿️ Auf dem Gehweg parken nur mit Zeichen 315 (Schild „Parken auf Gehwegen“) oder markierter Parkfläche',
  '🕐 Parkscheibe auf die <b>nächste halbe Stunde</b> vorstellen (10:05 → 10:30)',
  '🚒 Vor Feuerwehrzufahrten nicht halten. In zweiter Reihe nicht halten (Ausnahme: Taxi zum Ein- und Aussteigen)',
  '🚲 Bei „Verbot für Fahrzeuge aller Art“ (250) darf man Rad <b>schieben</b>',
  '🌿 <b>Umweltzone</b>: nur mit (grüner) Plakette, sonst Bußgeld',
  '🚑 Blaulicht + Martinshorn: sofort freie Bahn. Blaulicht ohne Horn: Warnung vor Unfall- oder Einsatzstelle, Einsatzfahrt (Platz machen) oder geschlossener Verband (zusammengehörige Kolonne, z. B. Polizei, Bundeswehr, Rettung)',
  '❤️ Erste Hilfe: <b>30 × drücken, 2 × beatmen</b>, ca. 100–120 pro Minute',
  '🪪 Immer dabei: Führerschein + Zulassungsbescheinigung Teil I',
  '🔁 Probezeit: 2 Jahre, <b>0,0 ‰</b> und kein Cannabis, egal wie alt',
];
---
<Section id="vergessen" title="Oft verwechselt">
  <div class="flex flex-col gap-2.5">
    {PAIRS.map(([a, at, b, bt, why]) => (
      <div class="pair">
        <div><img src={img(a)} alt="" width="56" height="56" loading="lazy" /><span set:html={at} /></div>
        <div><img src={img(b)} alt="" width="56" height="56" loading="lazy" /><span set:html={bt} /></div>
        <p class="why"><b class="text-ink">Warum:</b> {why}</p>
      </div>
    ))}
  </div>
</Section>

<Section title="Oft vergessen">
  <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,260px),1fr))] gap-2.5">
    {FORGOTTEN.map(t => (
      <div class="rounded-box border-2 border-soft bg-surface px-3.5 py-[11px] text-[.9rem] leading-[1.45]" set:html={t} />
    ))}
  </div>
</Section>

<style>
  .pair{display:grid;grid-template-columns:1fr 1fr;border:2px solid var(--line);border-radius:var(--r);overflow:hidden;background:var(--surface)}
  .pair>div{display:flex;gap:12px;align-items:center;padding:12px 14px;font-size:.88rem;line-height:1.4}
  .pair>div+div{border-left:2px dashed var(--soft)}
  .pair img{width:56px;height:56px;flex:none;object-fit:contain}
  .pair .why{grid-column:1/-1;margin:0;padding:8px 14px;border-top:2px dashed var(--soft);font-size:.82rem;line-height:1.4;color:var(--muted)}
  @media(max-width:600px){.pair{grid-template-columns:1fr}.pair>div+div{border-left:0;border-top:2px dashed var(--soft)}}
</style>

---
import Section from '../Section.astro';
import Card from '../ui/Card.astro';
import Grid from '../ui/Grid.astro';
import Note from '../ui/Note.astro';
import Tip from '../ui/Tip.astro';

// Order of precedence (§ 36 Abs. 1, § 37 Abs. 1 StVO): a higher rung overrides every lower one.
const LADDER = ['👮 Polizei', '🚦 Ampel', '⛔ Schilder und Markierungen', '↔️ Rechts vor links'];
const DIAG = '[&_svg]:h-auto [&_svg]:w-full [&_svg]:rounded-box [&_svg]:border-2 [&_svg]:border-line [&_svg]:bg-bg2';
const ALWAYS_WAIT = [
  '🏠 Aus <b>Grundstück</b>, Parkplatz, Fußgängerzone, verkehrsberuhigtem Bereich oder über abgesenkten Bordstein (niedriger Bordstein an Einfahrten) raus: <b>alle</b> haben Vorrang (§ 10). Aus Feld- oder Waldweg: keine Vorfahrt (§ 8)',
  '🚨 <b>Blaulicht + Martinshorn</b> (Sirene): sofort freie Bahn schaffen',
  '🚌 Linienbus will von gekennzeichneter <b>Haltestelle</b> abfahren: abfahren lassen, notfalls warten',
  '🚊 <b>Straßenbahn</b>: normale Vorfahrtregeln, aber beim Abbiegen und neben dir in gleicher Richtung hat sie Vorrang',
  '🚶 Fußgänger am <b>Zebrastreifen</b> und beim Abbiegen in die Querstraße',
  '🚦 Stau hinter der Kreuzung: <b>nicht einfahren</b>, auch bei Grün',
];
---
<Section id="vorfahrt" title="Vorfahrt: oben schlägt unten">
  <ol class="flex flex-col gap-1.5">
    {LADDER.map((t, i) => (
      <li class="flex items-center gap-3 rounded-box border-2 border-line bg-surface px-3.5 py-2.5 font-bold" style={`margin-left:${i * 4}%`}>
        <span class="grid size-[26px] shrink-0 place-items-center rounded-full bg-ink text-[.8rem] text-bg" aria-hidden="true">{i + 1}</span>{t}
      </li>
    ))}
  </ol>
  <Tip label="Merksatz">„Polizei vor Ampel, Ampel vor Schild, Schild vor rechts vor links.“ Ampel aus oder gelb blinkend? Dann gelten die Schilder.</Tip>
  <Tip label="Merksatz">„Rot-Gelb heißt gleich, nicht jetzt.“ Bei Rot und Gelb zusammen wartest du noch, gleich kommt Grün.</Tip>
</Section>

<Section title="Vorfahrt: die Klassiker">
  <Grid min={300}>
    <Card icon="↔️" title="Rechts vor links">
      <div class={DIAG}>
        <svg viewBox="0 0 300 190" role="img" aria-label="Kreuzung ohne Schilder: das Auto von rechts fährt zuerst">
          <rect x="118" y="0" width="64" height="190" fill="#c7ced6"/>
          <rect x="0" y="70" width="300" height="64" fill="#c7ced6"/>
          <rect x="152" y="150" width="24" height="34" rx="5" fill="#d92f2f"/>
          <rect x="236" y="74" width="34" height="24" rx="5" fill="#1565d8"/>
          <text x="164" y="172" font-size="11" fill="#fff" text-anchor="middle" font-weight="800">DU</text>
          <text x="253" y="90" font-size="12" fill="#fff" text-anchor="middle" font-weight="800">1</text>
        </svg>
      </div>
      <Note class="mt-2">Keine Schilder, keine Ampel: <b>wer von rechts kommt, fährt zuerst.</b> Gilt auch in fast allen Tempo-30-Zonen.</Note>
      <Tip label="Merksatz">„Wer rechts frei hat, fährt zuerst.“</Tip>
    </Card>

    <Card icon="↩️" title="Links abbiegen">
      <div class={DIAG}>
        <svg viewBox="0 0 300 190" role="img" aria-label="Linksabbieger wartet auf Gegenverkehr">
          <rect x="118" y="0" width="64" height="190" fill="#c7ced6"/>
          <rect x="0" y="70" width="300" height="64" fill="#c7ced6"/>
          <rect x="124" y="6" width="22" height="32" rx="5" fill="#1565d8"/>
          <text x="135" y="27" font-size="12" fill="#fff" text-anchor="middle" font-weight="800">1</text>
          <rect x="154" y="150" width="22" height="32" rx="5" fill="#d92f2f"/>
          <path d="M165 150 q0 -32 -50 -32" fill="none" stroke="#d92f2f" stroke-width="3" stroke-dasharray="6 5"/>
          <text x="165" y="172" font-size="11" fill="#fff" text-anchor="middle" font-weight="800">DU</text>
        </svg>
      </div>
      <Note class="mt-2">Wer links abbiegt, lässt den <b>Gegenverkehr</b> und Fußgänger der Zielstraße zuerst. Kommen sich zwei Linksabbieger entgegen: <b>voreinander</b> abbiegen, außer Verkehr oder Bauart der Kreuzung verlangen, erst aneinander vorbeizufahren.</Note>
      <Tip label="Merksatz">„Links abbiegen: Gegenverkehr zuerst.“</Tip>
    </Card>

    <Card icon="🔄" title="Kreisverkehr">
      <div class={DIAG}>
        <svg viewBox="0 0 300 190" role="img" aria-label="Kreisverkehr: rein ohne Blinker, raus mit Blinker rechts">
          <circle cx="150" cy="95" r="70" fill="#c7ced6"/>
          <circle cx="150" cy="95" r="32" fill="#7fb77e"/>
          <rect x="130" y="160" width="40" height="30" fill="#c7ced6"/>
          <rect x="215" y="75" width="85" height="40" fill="#c7ced6"/>
          <rect x="150" y="160" width="20" height="28" rx="4" fill="#d92f2f"/>
          <text x="150" y="152" font-size="11" text-anchor="middle" font-weight="800" fill="var(--ink)">rein: kein Blinker</text>
          <circle cx="218" cy="103" r="5" fill="#f5a400"/>
          <text x="258" y="70" font-size="11" text-anchor="middle" font-weight="800" fill="var(--ink)">raus: rechts ▸</text>
          <path d="M160 145 A50 50 0 0 0 200 95" fill="none" stroke="#d92f2f" stroke-width="3" stroke-dasharray="6 5"/>
        </svg>
      </div>
      <Note class="mt-2">Mit Zeichen 215 (blaues Kreisverkehr-Schild) + 205 (Vorfahrt gewähren, Dreieck): <b>der Kreis hat Vorfahrt</b>. Beim Einfahren blinken ist <b>verboten</b>, beim Ausfahren <b>Pflicht</b>. Im Kreis nicht halten.</Note>
      <Tip label="Merksatz">„Rein ohne, raus mit.“ Gemeint ist der Blinker.</Tip>
    </Card>

    <Card icon="↪️" title="Abknickende Vorfahrt">
      <div class={DIAG}>
        <svg viewBox="0 0 300 190" role="img" aria-label="Zusatztafel abknickende Vorfahrt: dicke Linie ist die Vorfahrtstraße">
          <rect x="105" y="10" width="90" height="170" rx="6" fill="#fff" stroke="#17171b" stroke-width="3"/>
          <path d="M150 170 V95 H112" stroke="#17171b" stroke-width="12" fill="none"/>
          <path d="M150 95 V22 M150 95 H188" stroke="#17171b" stroke-width="4" fill="none"/>
          <text x="235" y="80" font-size="11" font-weight="800" fill="var(--ink)">dick =</text>
          <text x="235" y="95" font-size="11" font-weight="800" fill="var(--ink)">Vorfahrt</text>
        </svg>
      </div>
      <Note class="mt-2">Die <b>dicke Linie</b> ist die Vorfahrtstraße. Folgst du dem Knick, behältst du Vorfahrt, musst aber <b>blinken</b>. Untereinander gilt auf den dünnen Ästen (Straßen ohne Vorfahrt) rechts vor links.</Note>
      <Tip label="Merksatz">„Folgst du dem Knick, blink.“</Tip>
    </Card>

    <Card icon="🪢" title="Reißverschluss">
      <div class={DIAG}>
        <svg viewBox="0 0 300 120" role="img" aria-label="Reißverschluss: bis zum Ende der Spur fahren, dann abwechselnd einfädeln">
          <rect x="0" y="20" width="300" height="40" fill="#c7ced6"/>
          <path d="M0 60 H200 L240 60 L240 60 L200 100 H0 Z" fill="#c7ced6"/>
          <path d="M0 60 H200" stroke="#fff" stroke-width="2" stroke-dasharray="10 8"/>
          <rect x="40" y="28" width="30" height="22" rx="4" fill="#1565d8"/><rect x="110" y="28" width="30" height="22" rx="4" fill="#1565d8"/>
          <rect x="75" y="70" width="30" height="22" rx="4" fill="#d92f2f"/><rect x="150" y="70" width="30" height="22" rx="4" fill="#d92f2f"/>
          <path d="M182 80 Q205 78 220 50" stroke="#d92f2f" stroke-width="3" fill="none" stroke-dasharray="5 4"/>
          <text x="250" y="110" font-size="11" text-anchor="middle" font-weight="800" fill="var(--ink)">erst am Ende</text>
        </svg>
      </div>
      <Note class="mt-2">Endende Spur <b>bis zum Ende</b> nutzen, dann abwechselnd je ein Fahrzeug (§ 7 Abs. 4). Nicht zu früh wechseln.</Note>
      <Tip label="Merksatz">„Erst bis zum Ende, dann abwechselnd.“</Tip>
    </Card>

    <Card icon="👮" title="Polizei-Zeichen">
      <div class={DIAG}>
        <svg viewBox="0 0 300 120" role="img" aria-label="Drei Haltungen des Polizisten">
          <g transform="translate(60,12)"><circle cx="0" cy="10" r="9" fill="var(--ink)"/><rect x="-7" y="21" width="14" height="34" rx="4" fill="var(--ink)"/><path d="M-7 26 H-34 M7 26 H34" stroke="var(--ink)" stroke-width="6"/><text x="0" y="78" font-size="11" text-anchor="middle" fill="var(--muted)" font-weight="700">1</text></g>
          <g transform="translate(150,12)"><circle cx="0" cy="10" r="9" fill="var(--ink)"/><rect x="-7" y="21" width="14" height="34" rx="4" fill="var(--ink)"/><path d="M0 21 L0 -6" stroke="var(--ink)" stroke-width="6"/><text x="0" y="78" font-size="11" text-anchor="middle" fill="var(--muted)" font-weight="700">2</text></g>
          <g transform="translate(240,12)"><circle cx="0" cy="10" r="9" fill="var(--ink)"/><rect x="-7" y="21" width="14" height="34" rx="4" fill="var(--ink)"/><path d="M7 26 L34 16" stroke="var(--ink)" stroke-width="6"/><text x="0" y="78" font-size="11" text-anchor="middle" fill="var(--muted)" font-weight="700">3</text></g>
        </svg>
      </div>
      <Note class="mt-2"><b>1</b> Brust oder Rücken zu dir: <b>Halt</b> (wie Rot). Seitlich: frei (wie Grün). <b>2</b> Arm hoch: vor der Kreuzung warten, wer schon drin ist, räumt die Kreuzung (<b>wie Gelb</b>). <b>3</b> Winken: diese Richtung fahren.</Note>
      <Tip label="Merksatz">„Brust und Rücken: Rot. Seite: Grün. Arm hoch: Gelb.“</Tip>
    </Card>
  </Grid>
</Section>

<Section title="Vorfahrt: immer warten">
  <Note class="mb-3"><b>Vorfahrt</b> gibt es an Kreuzungen und Einmündungen. <b>Vorrang</b> heißt: du lässt andere zuerst, auch ohne Kreuzung, z. B. Fußgänger, an Engstellen oder wenn du aus einer Ausfahrt kommst.</Note>
  <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,260px),1fr))] gap-2.5">
    {ALWAYS_WAIT.map(t => <div class="rounded-box border-2 border-soft bg-surface px-3.5 py-[11px] text-[.9rem] leading-[1.45]" set:html={t} />)}
  </div>
  <Tip label="Merksatz">„Aus dem Hof? Alle anderen zuerst.“ (§ 10)</Tip>
</Section>

<Section title="Grünpfeil">
  <div class="grid grid-cols-2 gap-3">
    <div class="rounded-box border-2 border-line bg-surface p-3.5 text-[.88rem] leading-[1.45]"><b>Grünpfeil-Schild</b> (Blech, § 37) neben Rot<br/><span class="mt-2 mb-1 block font-display text-[1.6rem] text-warn">STOPP</span>erst ganz anhalten, dann rechts abbiegen, nur aus dem rechten Fahrstreifen, niemanden behindern</div>
    <div class="rounded-box border-2 border-line bg-surface p-3.5 text-[.88rem] leading-[1.45]"><b>Leuchtender</b> grüner Pfeil in der Ampel<br/><span class="mt-2 mb-1 block font-display text-[1.6rem] text-go">FAHREN</span>normale freie Fahrt in Pfeilrichtung</div>
  </div>
  <Tip label="Merksatz">Grünpfeil-Schild: „Erst stehen, dann abbiegen.“</Tip>
</Section>

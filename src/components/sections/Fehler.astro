---
import Section from '../Section.astro';
import Note from '../ui/Note.astro';
import Tip from '../ui/Tip.astro';

// Errors that end the practical exam at once (Prüfungsrichtlinie, FeV Anlage 7).
const FAILS = [
  '<b>Vorfahrt oder Vorrang</b> missachtet (auch beim Anfahren vom Rand)',
  '<b>Rot</b> oder ein Vorschriftzeichen (Gebots- und Verbotsschilder, meist rund) missachtet, z. B. bei Stopp nicht angehalten',
  '<b>Tempo:</b> innerorts mehr als 5, außerorts mehr als 10 km/h zu schnell und nicht in 3 s korrigiert',
  'Überholen bei <b>unklarer Lage</b>, oder schneller werden, während du überholt wirst',
  'Auf den <b>Schienen</b> halten, falsch herum im <b>Kreisverkehr</b>',
  '<b>Bus</b> überholen, der mit Warnblinker an die Haltestelle heranfährt, oder am haltenden Bus deutlich schneller als Schritttempo vorbei',
  '<b>Überholverbot</b> missachtet (auch am Zebrastreifen), grundlos auf der Gegenfahrbahn, falscher Pfeil-Fahrstreifen (Spur mit Richtungspfeilen auf der Fahrbahn)',
  '<b>Abstand</b> unter 1/4 Tacho ohne Korrektur, andere blenden',
  'Verkehr <b>gar nicht beobachtet</b>, vermeidbar von der Fahrbahn abgekommen',
  'Fahrlehrer oder Prüfer muss <b>eingreifen</b>, um eine Gefahr zu verhindern',
];
---
<Section id="fehler" title="Sofort durchgefallen">
  <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,220px),1fr))] gap-2.5">
    {FAILS.map(f => <div class="rounded-r-box border-l-[5px] border-warn bg-surface px-3.5 py-2.5 text-[.9rem]" set:html={f} />)}
  </div>
  <Tip label="Merksatz">„Ein Viertel Tacho Abstand: Prüfung vorbei.“ Bei 80 km/h also unter 20 m.</Tip>
  <Note class="mt-[clamp(10px,1.6vw,16px)]">Viele kleine Fehler (z. B. Schulterblick mehrmals vergessen) können zusammen auch zum Nichtbestehen führen. Bewertet werden 5 Bereiche: <b>Verkehrsbeobachtung, Fahrzeugpositionierung, Geschwindigkeit, Kommunikation, Fahrzeugbedienung und umweltbewusstes Fahren</b>.</Note>
</Section>

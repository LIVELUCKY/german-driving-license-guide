---
import Section from '../Section.astro';
import Card from '../ui/Card.astro';
import Grid from '../ui/Grid.astro';
import Kv from '../ui/Kv.astro';
import Steps from '../ui/Steps.astro';
import Tip from '../ui/Tip.astro';

// Fahreignungsregister stages (§ 4 StVG) and deletion periods (§ 29 StVG).
const STAGES = [
  { from: 1, to: 3, label: 'vorgemerkt', color: 'bg-[#9fd8a0]' },
  { from: 4, to: 5, label: 'Ermahnung', color: 'bg-[#f5b50a]' },
  { from: 6, to: 7, label: 'Verwarnung', color: 'bg-[#f08c2e]' },
  { from: 8, to: 8, label: 'weg', color: 'bg-warn text-white' },
];
const TILGUNG = [
  ['1 Punkt', 'nach 2,5 Jahren'],
  ['2 Punkte', 'nach 5 Jahren'],
  ['3 Punkte (Straftat mit Entzug)', 'nach 10 Jahren'],
];
const PROBEZEIT = [
  '<b>2 Jahre</b> ab dem ersten Führerschein',
  '1 schwerer (A) oder 2 leichtere (B) Verstöße → <b>Aufbauseminar + 2 Jahre länger</b>',
  'noch einmal → <b>Verwarnung</b>, verkehrspsychologische Beratung empfohlen',
  'noch einmal → <b>Führerschein weg</b>',
];
---
<Section id="punkte" title="Punkte und Probezeit">
  <div class="grid grid-cols-8 gap-1" role="img" aria-label="Punkteskala Flensburg: 1 bis 3 vorgemerkt, 4 bis 5 Ermahnung, 6 bis 7 Verwarnung, 8 Führerschein weg">
    {STAGES.map(s => (
      <div class="grid gap-1" style={`grid-column: span ${s.to - s.from + 1}`}>
        <div class="grid gap-1" style={`grid-template-columns: repeat(${s.to - s.from + 1}, 1fr)`}>
          {Array.from({ length: s.to - s.from + 1 }, (_, i) => (
            <span class:list={['grid h-11 place-items-center rounded-sm font-display text-lg text-fixed-ink', s.color]}>{s.from + i}</span>
          ))}
        </div>
        <span class:list={['rounded-sm px-1.5 py-1 text-[.62rem] leading-tight font-bold text-fixed-ink sm:text-[.72rem]', s.color]}>{s.from === s.to ? s.from : `${s.from}–${s.to}`} {s.label}</span>
      </div>
    ))}
  </div>
  <Tip label="Merksatz">„<b>4</b> ermahnt, <b>6</b> verwarnt, <b>8</b> weg.“ Gelöscht wird nach <b>2,5 · 5 · 10</b> Jahren.</Tip>

  <Grid min={300} class="mt-4">
    <Card icon="🗓️" title="Wann Punkte verfallen">
      {TILGUNG.map(([l, v]) => <Kv label={l!}>{v}</Kv>)}
    </Card>
    <Card icon="🪪" title="Probezeit">
      <Steps items={PROBEZEIT} />
      <Tip label="Merksatz">„Einmal A oder zweimal B: Seminar und 2 Jahre mehr.“</Tip>
    </Card>
  </Grid>
</Section>

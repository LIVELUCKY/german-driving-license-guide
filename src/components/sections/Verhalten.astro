---
import Section from '../Section.astro';
import Bullets from '../ui/Bullets.astro';
import Fold from '../ui/Fold.astro';
import Note from '../ui/Note.astro';

// Ten topics, each with a visible memory hook and its rules (inline HTML allowed).
type Topic = { icon: string; title: string; hook: string; rules: string[] };
const TOPICS: Topic[] = [
  { icon: '🧒', title: 'Menschen am Straßenrand', hook: 'Kinder rennen los, Ältere bleiben stehen', rules: [
    '<b>Ball rollt</b> auf die Straße: bremsen, nicht ausweichen. Ein Kind kommt hinterher',
    'Kinder auf dem Gehweg: <b>langsamer, bremsbereit</b>, nicht hupen',
    'Kind mit Hund: Hund reißt los, <b>Kind rennt hinterher</b>',
    'Ältere Menschen <b>bleiben stehen oder drehen um</b> auf der Fahrbahn',
    'Weißer Stock, gelbe Binde mit 3 Punkten (Zeichen für blinde Menschen): langsamer, notfalls <b>anhalten</b>, nicht hupen',
    'Rollstuhl kommt nicht auf den Bordstein: anhalten, Warnblinker, <b>helfen</b>',
    'Fußgänger durchlassen: anhalten. <b>Lichthupe als Einladung ist falsch</b>',
  ] },
  { icon: '🚌', title: 'Bus und Straßenbahn', hook: 'Bus kommt: nicht überholen. Bus steht: Schritttempo', rules: [
    'Linien- oder Schulbus hält mit Warnblinker an der Haltestelle: <b>Schritttempo</b>, auch für den Gegenverkehr auf derselben Fahrbahn',
    'Bus fährt mit Warnblinker heran: <b>nicht überholen</b>',
    'Straßenbahn-Haltestelle ohne Insel, Fahrgäste steigen ein oder aus: rechts nur <b>Schritttempo</b>, niemand gefährden oder behindern, sonst warten',
    'Fahrende Straßenbahn <b>rechts</b> überholen. Links nur in Einbahnstraße oder wenn Schienen zu weit rechts liegen',
  ] },
  { icon: '🚲', title: 'Rad, Reiter, Tiere', hook: 'Wild: bremsen, nicht ausweichen', rules: [
    'Seitenabstand zum Rad: mindestens <b>1,5 m innerorts, 2 m außerorts</b>, mehr bei Kindern und Tempo. Nur 50 cm Platz: <b>nicht überholen</b>',
    'Radfahrer am Berg <b>pendeln</b>: mehr Abstand',
    'Rechne mit Rädern in falscher Richtung, ohne Licht. <b>E-Bikes</b> sind schneller als gedacht',
    'Pferdekutsche: leise, viel Abstand, auf Handzeichen achten',
    'Wildwechsel vor allem in der <b>Dämmerung</b>. Nach einem Reh kommen oft weitere',
    'Wild im Licht: <b>abblenden, hupen, bremsen</b>',
    'Unfall mit Wild unvermeidbar: voll bremsen, <b>Lenkrad gerade</b>. Merke: „Lieber Reh als Baum“',
    'Nach Wildunfall: absichern, Polizei oder Förster rufen, Tier nicht mitnehmen',
  ] },
  { icon: '🌫️', title: 'Sicht, Wetter, Kurven', hook: 'Geblendet? Rechten Rand anschauen', rules: [
    'Geblendet: auf den <b>rechten Fahrbahnrand</b> schauen, langsamer. Nie selbst aufblenden',
    'Fernlicht darf an bleiben, wenn Fußgänger <b>in gleicher Richtung</b> vorausgehen (Falle)',
    'Nebelscheinwerfer auch bei Regen/Schnee. Nebelschlussleuchte <b>nur bei Nebel &lt; 50 m</b>',
    'Im Nebel nicht auf der Mittellinie fahren. Nebel oft an Flüssen, Seen, Mooren',
    '<b>Erster Regen</b> nach Trockenheit: Schmierfilm, sofort mehr Abstand',
    'Glätte testen: nur ganz langsam und wenn niemand hinter dir ist, kurz bremsen. Öl auf der Straße: Feuerwehr rufen',
    'Seitenwind: <b>gegenlenken</b>, langsamer. Brücken, Waldschneisen, Lkw überholen',
    'Kurve: <b>vorher bremsen</b>, erst am Ausgang Gas geben',
    'Zu viel Gas in der Kurve: <b>wo der Antrieb ist, rutscht es</b>. Frontantrieb schiebt vorne nach außen, Heckantrieb bricht hinten aus',
    'Nach langer schneller Fahrt unterschätzt man das eigene Tempo',
  ] },
  { icon: '🛣️', title: 'Überholen, Spuren, Autobahn', hook: 'Wirst du überholt: nie schneller werden', rules: [
    'Du wirst überholt: <b>nicht schneller werden</b>, rechts halten',
    'Überholen abbrechen, wenn der andere beschleunigt oder Gegenverkehr kommt',
    'Lichthupe hinter dir beim Überholen: <b>zügig fertig überholen</b>, dann rechts. Nicht bremsen',
    'Rechts überholen auf der Autobahn nur, wenn links eine Schlange <b>steht oder langsam fährt</b>, dann nur etwas schneller und sehr vorsichtig',
    'Einfädeln: schneller sein ist ok, aber die <b>Autobahn hat Vorfahrt</b>',
    'Ausfahrt verpasst: <b>bis zur nächsten</b> weiter. Nie zurück, nie halten',
    'Falsch eingeordnet: in <b>Pfeilrichtung</b> weiterfahren',
    'Stau: Kreuzung, Einmündung, Bahnübergang, Zebrastreifen <b>freihalten</b>',
    'Geschlossener Verband (zusammengehörige Kolonne, z. B. Polizei, Bundeswehr): durchlassen, auch bei Grün',
    'Abknickende Vorfahrt <b>geradeaus</b> verlassen: nicht blinken',
    'Lässt dich jemand mit Vorfahrt vor: erst fahren, wenn ihr euch <b>eindeutig verständigt</b> habt, z. B. per Handzeichen',
  ] },
  { icon: '🚂', title: 'Bahnübergang', hook: 'Rot blinkt = warten, auch bei offener Schranke', rules: [
    'Rotes Blinklicht, Halbschranke noch offen: <b>warten</b>',
    'Nach dem Zug erst fahren, wenn das <b>Blinklicht aus</b> ist',
    'Warten <b>vor dem Andreaskreuz</b>, nicht an der Schranke',
    'Schranke bewegt sich lange nicht: nicht queren, Polizei rufen',
    'Weiß-rot-weiße Fahne oder rote Leuchte eines Bahnmitarbeiters: warten',
  ] },
  { icon: '👮', title: 'Polizei, Unfall, Tunnel', hook: 'Feuer im Tunnel: Schlüssel stecken lassen', rules: [
    '„STOP POLIZEI“ oder „BITTE FOLGEN“ gilt <b>nur für dich</b>',
    'Rot überfahren nur, um einem Einsatzfahrzeug <b>vorsichtig Platz</b> zu machen oder auf Polizeizeichen',
    'Blaulicht + Horn: rechts ran, langsamer, <b>nicht sofort stehen bleiben</b>',
    'Geparktes Auto beschädigt: warten, Namen und Anschrift hinterlassen, <b>Polizei informieren</b>',
    'Schwarze Pfeile auf Leitpfosten zeigen zur nächsten <b>Notrufsäule</b>',
    'Feuer im Tunnel: Warnblinker, Motor aus, <b>Schlüssel stecken lassen</b>, über Notausgang raus',
    'Orange Gefahrgut-Tafel: die <b>Zahlen beim Notruf</b> durchgeben',
  ] },
  { icon: '🔧', title: 'Technik und Assistenten', hook: 'Öldruck-Leuchte bleibt an: Motor sofort aus', rules: [
    '<b>ABS</b> (Antiblockiersystem): beim Bremsen lenkbar. Verhindert kein Aquaplaning, keine schnelleren Kurven',
    '<b>ASR</b> (Antriebsschlupfregelung): kein Durchdrehen beim Anfahren. <b>ESP</b> (Schleuderschutz) blinkt = zu schnell, leuchtet dauernd = aus oder defekt',
    'Spurhalteassistent braucht klare Linien. Übersteuern durch Lenken oder Blinker',
    'Abstandstempomat (Tempomat, der selbst bremst und Abstand hält) kann bei Regen/Schnee ausfallen. Tempomat übersteuern mit <b>Bremse oder Gas</b>',
    'Assistenten gleichen <b>Müdigkeit nicht aus</b>',
    'Kontrollleuchten: Fernlicht <b>blau</b>, Nebelschluss <b>gelb</b>. Öldruck bleibt an: <b>Motor sofort aus</b>',
    'Blinker-Kontrolle blinkt <b>viel schneller als sonst</b>: eine Lampe ist kaputt',
    'Bremspedal geht bis zum Boden: <b>stehen lassen</b>. Bremsflüssigkeit wird gewechselt, weil sie Wasser zieht',
    'Langes Gefälle: <b>kleiner Gang</b>, nie Leerlauf oder getretene Kupplung',
    'Zu wenig Luft: Reifen wird heiß. Auto zieht nach links: evtl. vorne links zu wenig Luft',
    'Radwechsel: sichern, <b>Muttern lösen</b>, dann erst anheben. Später nachziehen',
    'Abschleppen mit Motorschaden: Bremse und Lenkung gehen <b>schwer</b>. Besser Abschleppstange',
  ] },
  { icon: '🪑', title: 'Sitzen und Sichern', hook: 'Gang gegen die Rollrichtung', rules: [
    'Kopfstütze: Oberkante etwa auf <b>Höhe Kopfoberkante</b>, nah am Hinterkopf',
    'Gurt straff, nicht verdreht, nie unter dem Arm. Dicke Winterjacke schwächt ihn',
    'Gurt auf allen Sitzen, <b>auch mit Airbag</b>',
    'Kind 11 Jahre, 140 cm: <b>Sitzerhöhung</b> + Dreipunktgurt',
    'Gegen Wegrollen: Handbremse + <b>1. Gang oder Rückwärtsgang</b>. Automatik: Handbremse + <b>P</b>',
  ] },
  { icon: '🌱', title: 'Umwelt', hook: 'Starten und gleich losfahren', rules: [
    'Nach dem Start <b>sofort losfahren</b>, nicht warmlaufen lassen',
    'Motor aus an der <b>Bahnschranke</b>, nicht am Stoppschild',
    'Klimaanlage und Sitzheizung kosten Sprit. Luftwiderstand hängt vor allem vom <b>Tempo</b> ab',
    'Automatik: <b>Kickdown</b> (Gaspedal ganz durchtreten) vermeiden',
    'Umweltplakette innen an die Scheibe, gilt nur geklebt. Motorräder brauchen keine',
  ] },
];
---
<Section id="verhalten" title="Oft gefragt: Verhalten und Technik">
  <Note class="mb-3">Zehn Themen, je ein Merksatz. Lies erst nur die Merksätze, dann öffne ein Thema.</Note>
  <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,420px),1fr))] items-start gap-2.5">
    {TOPICS.map(t => (
      <Fold icon={t.icon} title={t.title} hook={t.hook} count={t.rules.length}>
        <Bullets items={t.rules} />
      </Fold>
    ))}
  </div>
</Section>

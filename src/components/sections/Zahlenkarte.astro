---
import Section from '../Section.astro';
import Note from '../ui/Note.astro';
import Tip from '../ui/Tip.astro';
import { ZAHLENKARTE, UNIT } from '../../data/cheatsheet';
---
<Section id="zahlenkarte" title="Zahlen-Landkarte: eine Zahl, viele Regeln">
  <Note class="mb-[clamp(8px,1.2vw,12px)]">Viele Prüfungszahlen kommen mehrfach vor. Lerne pro Zahl, wofür sie steht. Die Farbe zeigt die Einheit.</Note>
  <div class="units">{Object.entries(UNIT).map(([k, l]) => <span class={`u-${k}`}>{l}</span>)}</div>
  <div class="zmap">
    {ZAHLENKARTE.map(z => (
      <div class="ztile">
        <b class="zn">{z.n}</b>
        <ul>{z.items.map(([f, u, t]) => <li class={`u-${f}`}><i>{u}</i> {t}</li>)}</ul>
      </div>
    ))}
  </div>
  <Tip label="Merke die großen Familien"><b>5 · 8 · 15</b> Meter Parken, <b>50 · 80 · 100</b> km/h Tempo, <b>0,0 · 0,3 · 0,5 · 1,1 · 1,6</b> Promille, <b>1,5 · 2</b> Meter Seitenabstand.</Tip>
</Section>

<style>
  .units{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:12px}
  .units span{font-size:.75rem;font-weight:700;padding:3px 10px;border-radius:999px;border-left:6px solid var(--u);background:var(--surface)}
  .u-kmh{--u:#c62828}.u-m{--u:var(--pop2)}.u-pm{--u:#ef8f1a}.u-zeit{--u:#16a06a}.u-x{--u:#8a8a93}
  .zmap{columns:4 220px;column-gap:10px}
  .ztile{break-inside:avoid;margin-bottom:10px;background:var(--surface);border:2px solid var(--line);border-radius:var(--r);padding:10px 12px}
  .zn{display:block;font-family:var(--display);font-size:1.9rem;line-height:1;margin-bottom:6px}
  .ztile ul{list-style:none;display:flex;flex-direction:column;gap:5px}
  .ztile li{font-size:.84rem;line-height:1.35;padding-left:9px;border-left:4px solid var(--u)}
  .ztile li i{font-style:normal;font-weight:800;color:var(--ink)}
  @media(max-width:600px){.zmap{columns:2;column-gap:8px}.ztile{padding:8px 9px}.zn{font-size:1.5rem}.ztile li{font-size:.78rem}}
  @media print{.zmap{columns:3}}
</style>

---
import Section from '../Section.astro';
import Card from '../ui/Card.astro';
import Grid from '../ui/Grid.astro';
import Kv from '../ui/Kv.astro';
import Note from '../ui/Note.astro';
import Tip from '../ui/Tip.astro';
import { STOP, pct, FORMULAS, TROWS, de } from '../../data/cheatsheet';

const H3 = 'mt-7 mb-3 font-display text-base uppercase tracking-[.04em]';
// Glossary of the four distances; `c` is the colour of the left marker.
const DEFS = [
  { c: 'border-blue', t: 'Reaktionsweg', d: 'Strecke vom <b>Sehen</b> der Gefahr bis der Fuß <b>auf der Bremse</b> ist. Das Auto fährt in dieser Zeit (ca. 1 Sekunde) <b>ungebremst</b> weiter.' },
  { c: 'border-[#b8280e]', t: 'Bremsweg', d: 'Strecke vom <b>Bremsbeginn</b> bis zum <b>Stillstand</b>. Bei einer Gefahrbremsung (voll treten) ungefähr halb so lang.' },
  { c: 'border-ink', t: 'Anhalteweg', d: 'Die <b>ganze</b> Strecke bis das Auto steht: Reaktionsweg + Bremsweg. Er muss kürzer sein als die Strecke, die du siehst.' },
  { c: 'border-go', t: 'Sicherheitsabstand', d: 'Lücke zum Vordermann. Außerorts „halber Tacho“ in Metern, sonst 2 Sekunden.' },
];
const TCOLS = ['Tempo', 'T', 'Reaktion 3·T', 'Bremsen T·T', 'Gefahr T·T÷2', 'Anhalteweg', 'Abstand 5·T'];
const KEY = [['', 'Tacho ÷ 10'], ['× 3', 'Reaktion'], ['hoch 2', 'Bremsen'], ['÷ 2', 'Gefahr'], ['+', 'Anhalten']];
const QUADRAT = [
  ['doppelt so schnell', '4 × Bremsweg'],
  ['dreimal so schnell', '9 × Bremsweg'],
  ['Reaktionsweg', 'wächst nur ×2 / ×3'],
  ['Fliehkraft in der Kurve', 'auch im Quadrat: 2× Tempo = 4×'],
];
const ABSTAND = [
  ['außerorts', 'halber Tacho in m'],
  ['100 km/h', '50 m'],
  ['Faustregel', '2 Sekunden'],
  ['Stadt, 50 km/h', '15 m = 3 Pkw-Längen'],
];
const REAKTION = [
  ['Faustformel', '1 Sekunde'],
  ['länger durch', 'Müdigkeit, Alkohol, Ablenkung'],
];
---
<Section id="formeln" title="Formeln">
  <h3 class={H3}>Was ist was? (Beispiel 50 km/h)</h3>
  <div class="stopline" role="img" aria-label="Anhalteweg bei 50 km/h: 15 m Reaktionsweg plus 25 m Bremsweg">
    <div class="sl-marks"><span>⚠️ Gefahr gesehen</span><span>🦶 Fuß auf der Bremse</span><span>🛑 Auto steht</span></div>
    <div class="sl-bar"><span class="sl-r">Reaktionsweg 15 m</span><span class="sl-b">Bremsweg 25 m</span></div>
    <div class="sl-total">Anhalteweg 40 m</div>
  </div>
  <div class="mt-3 grid grid-cols-[repeat(auto-fit,minmax(min(100%,220px),1fr))] gap-2.5">
    {DEFS.map(d => (
      <div class="rounded-box border border-soft bg-surface px-3 py-2.5 text-[.86rem] leading-[1.45]">
        <b class:list={['mb-1 block border-l-[5px] pl-2.5 text-[.8rem] uppercase tracking-[.05em]', d.c]}>{d.t}</b>
        <Fragment set:html={d.d} />
      </div>
    ))}
  </div>

  <h3 class={H3}>Der T-Trick: alles mit einer Zahl</h3>
  <Note class="mb-[clamp(8px,1.2vw,12px)]">Nimm vom Tacho die Null weg: <b>T = Tempo ÷ 10</b> (die Tacho-Ziffer, also das Tempo ohne die letzte Null). Dann brauchst du nur noch: Reaktion <b>3·T</b>, Bremsen <b>T·T</b>, Gefahr <b>T·T ÷ 2</b>, Abstand <b>5·T</b>.</Note>
  <div class="tablewrap">
    <table class="spd">
      <thead><tr>{TCOLS.map(c => <th>{c}</th>)}</tr></thead>
      <tbody>
        {TROWS.map(r => <tr><td>{r.v} km/h</td><td><b>{r.t}</b></td><td>{de(r.r)} m</td><td>{de(r.b)} m</td><td>{de(r.g)} m</td><td><b>{de(r.a)} m</b></td><td>{de(r.s)} m</td></tr>)}
      </tbody>
    </table>
  </div>

  <h3 class={H3}>Die Formeln Schritt für Schritt</h3>
  <div class="formula-key">
    {KEY.map(([op, t], i) => <>{i === 1 && <i>dann</i>}<span>{op && <b>{op}</b>}{t}</span></>)}
  </div>
  <Tip label="Formel-Reim" class="text-[.92rem] leading-relaxed">
    <span class="block">„Null weg und <b>mal drei</b>, dann ist der Schreck vorbei.“ <i class="text-[.8rem] not-italic opacity-70">(Reaktionsweg)</i></span>
    <span class="block">„<b>Zahl mal Zahl</b>, so bremst du normal.“ <i class="text-[.8rem] not-italic opacity-70">(Bremsweg)</i></span>
    <span class="block">„Ist Gefahr im Spiel, ist <b>die Hälfte</b> das Ziel.“ <i class="text-[.8rem] not-italic opacity-70">(Gefahrbremsung)</i></span>
    <span class="block">„<b>Beides addiert</b>, dann stehst du garantiert.“ <i class="text-[.8rem] not-italic opacity-70">(Anhalteweg)</i></span>
    <span class="block">„<b>Halber Tacho</b> als Meter, so fährst du sicher weiter.“ <i class="text-[.8rem] not-italic opacity-70">(Abstand außerorts)</i></span>
  </Tip>
  <div class="fcards mt-4">
    {FORMULAS.map(f => (
      <div class:list={['fcard', 'hl' in f && 'hl']}>
        <div class="fc-h"><b>{f.name}</b><code>{f.x}</code></div>
        {f.ex.map(chain => (
          <div class="chain">{chain.map((c, i, a) => <span class:list={[i === a.length - 1 ? 'res' : i % 2 ? 'op' : '']}>{c}</span>)}</div>
        ))}
        <p class="fc-m">{f.m}</p>
        {'k' in f && <Tip label="Merksatz">{f.k}</Tip>}
      </div>
    ))}
  </div>

  <h3 class={H3}>Anhalteweg im Vergleich</h3>
  <div class="bars" role="img" aria-label="Anhalteweg bei 30, 40, 50, 70, 100 und 130 km/h">
    {STOP.map(s => (
      <div class="bar-row">
        <span class="bar-v">{s.v}</span>
        <div class="bar-track">
          <span class="bar-r" style={`width:${pct(s.r)}%`}></span><span class="bar-b" style={`width:${pct(s.b)}%`}></span>
        </div>
        <span class="bar-sum">{s.sum} m</span>
      </div>
    ))}
    <div class="legend"><span class="bar-r"></span>Reaktionsweg <span class="bar-b"></span>Bremsweg</div>
  </div>

  <Grid class="mt-[clamp(10px,1.6vw,16px)]">
    <Card icon="✖️" title="Quadrat-Regel">
      {QUADRAT.map(([l, v]) => <Kv label={l!}>{v}</Kv>)}
      <Tip label="Merksatz">„Doppelt so schnell, viermal so weit.“ Bremsweg und Fliehkraft wachsen <b>im Quadrat</b>, Reaktionsweg nur <b>einfach</b>.</Tip>
    </Card>
    <Card icon="📏" title="Sicherheitsabstand">
      {ABSTAND.map(([l, v]) => <Kv label={l!}>{v}</Kv>)}
      <Tip label="Merksatz">„<b>Einundzwanzig, zweiundzwanzig</b>“ zählen, ab dem Leitpfosten, den der Vordermann passiert.</Tip>
    </Card>
    <Card icon="⏱️" title="Reaktionszeit">
      {REAKTION.map(([l, v]) => <Kv label={l!}>{v}</Kv>)}
      <Tip label={false}>In 1 Sekunde fährst du bei 50 km/h etwa <b>14 m</b> blind (km/h ÷ 3,6 = m/s).</Tip>
    </Card>
  </Grid>
</Section>

<style>
  .stopline{background:var(--surface);border:2px solid var(--line);border-radius:var(--r);padding:14px 16px}
  .sl-marks{display:grid;grid-template-columns:37.5% 62.5% 0;font-size:.78rem;font-weight:700;margin-bottom:6px}
  .sl-marks span:last-child{justify-self:end;white-space:nowrap}
  .sl-marks span:nth-child(2){padding-left:4px}
  .sl-bar{display:flex;height:34px;border-radius:4px;overflow:hidden;font-size:.8rem;font-weight:700;color:#fff}
  .sl-bar span{display:flex;align-items:center;padding-inline:10px;white-space:nowrap;overflow:hidden}
  .sl-r{width:37.5%;background:var(--pop2)}.sl-b{width:62.5%;background:#b8280e}
  .sl-total{margin-top:6px;border-top:3px solid var(--ink);padding-top:4px;text-align:center;font-family:var(--display);font-size:.95rem}

  .tablewrap{overflow-x:auto;border:2px solid var(--line);border-radius:var(--r);box-shadow:var(--shadow-sm);background:var(--surface);-webkit-overflow-scrolling:touch}
  table.spd{width:100%;border-collapse:collapse;font-size:.88rem;min-width:620px}
  table.spd th,table.spd td{padding:11px 13px;text-align:center;border-bottom:1px solid var(--soft);font-variant-numeric:tabular-nums}
  table.spd th{background:var(--ink);color:var(--bg);font-size:.7rem;text-transform:uppercase;letter-spacing:.08em}
  table.spd td:first-child,table.spd th:first-child{text-align:left;font-weight:700}
  table.spd tr:last-child td{border-bottom:0}
  table.spd tbody tr:hover{background:var(--bg2)}
  @media(max-width:540px){.tablewrap{margin-inline:calc(-1 * clamp(16px,4vw,32px));border-radius:0;border-left:0;border-right:0}}

  .formula-key{display:flex;flex-wrap:wrap;gap:6px;align-items:center;margin-bottom:10px}
  .formula-key span{background:var(--surface);border:2px solid var(--line);border-radius:999px;padding:6px 12px;font-size:.85rem}
  .formula-key span b{font-size:1rem;font-weight:800;color:var(--pop-text);margin-right:4px}
  .formula-key i{font-style:normal;color:var(--muted);font-size:.8rem}
  .fcards{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,270px),1fr));gap:12px}
  .fcard{background:var(--surface);border:2px solid var(--line);border-radius:var(--r);padding:14px 16px;display:flex;flex-direction:column;gap:8px}
  .fcard.hl{background:var(--pop3);color:#17171b}
  .fc-h{display:flex;justify-content:space-between;align-items:baseline;gap:8px;flex-wrap:wrap}
  .fc-h b{font-size:.78rem;text-transform:uppercase;letter-spacing:.08em}
  .fc-h code{font-family:var(--display);font-size:1.15rem}
  .chain{display:flex;flex-wrap:wrap;align-items:center;gap:4px;font-size:.85rem}
  .chain span{padding:3px 8px;border-radius:4px;background:var(--bg2);font-weight:700}
  .chain span.op{background:transparent;font-weight:500;color:var(--muted)}
  .chain span.op::before{content:"→ "}
  .chain span.res{background:#b8280e;color:#fff}
  .fcard.hl .chain span{background:rgba(255,255,255,.55)}
  .fcard.hl .chain span.op{background:transparent;color:#17171b}
  .fcard.hl .chain span.res{background:#b8280e;color:#fff}
  .fc-m{font-size:.82rem;line-height:1.4;margin:0}

  .bars{display:flex;flex-direction:column;gap:8px;background:var(--surface);border:2px solid var(--line);border-radius:var(--r);padding:16px}
  .bar-row{display:grid;grid-template-columns:44px 1fr 64px;align-items:center;gap:10px}
  .bar-v{font-weight:700;font-size:.85rem}
  .bar-v::after{content:" km/h";font-weight:400;font-size:.65rem;color:var(--muted)}
  .bar-track{display:flex;height:22px;background:var(--soft);border-radius:3px;overflow:hidden}
  .bar-r{background:var(--pop2)}.bar-b{background:var(--pop)}
  .bar-sum{font-family:var(--display);font-size:.95rem;text-align:right}
  .legend{display:flex;align-items:center;gap:8px;font-size:.78rem;color:var(--muted);margin-top:4px}
  .legend span{width:14px;height:14px;border-radius:2px;display:inline-block}
</style>

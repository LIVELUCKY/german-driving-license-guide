---
import Section from '../Section.astro';
import Card from '../ui/Card.astro';
import Note from '../ui/Note.astro';
import Steps from '../ui/Steps.astro';

// Everyday driving tasks in the practical exam (StVO §§ 5, 6, 9, 10, 19, 20; FeV Anlage 7).
const SITUATIONEN: { icon: string; title: string; steps: string[]; note?: string }[] = [
  { icon: '🚦', title: 'Anfahren vom Rand', steps: ['Blinker links', 'Spiegel, <b>Schulterblick links</b>', 'Lücke nutzen, Blinker aus'], note: 'Muss ein anderer deinetwegen stark bremsen = sofort durch.' },
  { icon: '🏠', title: 'Aus Einfahrt oder Parkplatz', steps: ['Langsam vortasten', '<b>Allen</b> Vorrang geben (§ 10)', 'Wenn nötig, einweisen lassen'] },
  { icon: '↔️', title: 'Fahrstreifenwechsel', steps: ['Nötig und erlaubt?', 'Spiegel, Blinker, <b>Schulterblick</b>', 'Tempo anpassen, wechseln, Blinker aus'] },
  { icon: '🛣️', title: 'Auf die Autobahn', steps: ['Früh auf die Hauptfahrbahn schauen', 'Einfädelungsstreifen (Spur zum Auffahren) <b>weit nutzen</b>, Tempo angleichen', 'Schulterblick links, einfädeln'], note: 'Mit unter 80 km/h einfädeln, wo 100 erlaubt ist und der Streifen lang genug ist = schwerer Fehler. Möglichst nicht anhalten, nur ohne Lücke am Ende des Streifens warten.' },
  { icon: '🚪', title: 'Von der Autobahn', steps: ['Früh blinken, früh rüber', 'Erst auf dem <b>Ausfädelungsstreifen</b> (Spur zum Abfahren) bremsen', 'Tacho prüfen: du bist schneller, als es sich anfühlt'] },
  { icon: '🚗', title: 'Überholen', steps: ['Erlaubt? Freie Sicht?', 'Spiegel, Blinker, Schulterblick, ausscheren', 'Rad: 1,5 m innerorts, 2 m außerorts', 'Blinker rechts, einscheren, Blinker aus'] },
  { icon: '🚧', title: 'Engstelle', steps: ['Hindernis auf <b>deiner</b> Seite: Gegenverkehr zuerst (§ 6)', 'Spiegel, evtl. Blinker, Schulterblick', 'Vorbei mit mind. 1 m Abstand bei 50'] },
  { icon: '🔄', title: 'Kreisverkehr', steps: ['Rein <b>ohne</b> Blinker', 'Kreis hat Vorfahrt (mit Zeichen 205)', 'Vor deiner Ausfahrt rechts blinken, <b>Schulterblick rechts</b> (Radfahrer)'] },
  { icon: '🚂', title: 'Bahnübergang', steps: ['Ab erster Bake nicht überholen', 'Gleise links und rechts prüfen', 'Vor dem Andreaskreuz warten', 'Nur fahren, wenn hinter den Schienen Platz ist'] },
  { icon: '↪️', title: 'Kurve', steps: ['Früh erkennen: Schild, Leitpfosten, Baumreihe', 'Vorher bremsen und Gang wählen', 'Rechts bleiben, <b>nicht schneiden</b>', 'Am Ausgang wieder Gas'], note: 'Vorsicht bei Kurven, die enger werden. Überholen vor der Kurve beenden.' },
  { icon: '✚', title: 'Kreuzung geradeaus', steps: ['Vorfahrt klären (Schild, Ampel, rechts vor links)', 'An der <b>Haltlinie</b> stehen, nicht darüber', 'Eigene Vorfahrt nutzen, nicht übertrieben zögern', 'Stau dahinter: <b>nicht einfahren</b>'] },
  { icon: '🚊', title: 'Straßenbahn', steps: ['Schienen sind glatt: möglichst <b>gerade</b> queren', 'Beim Abbiegen hat die Bahn in gleicher Richtung Vorrang', 'Nicht auf den Schienen warten, Abstand halten'] },
  { icon: '➡️', title: 'Geradeausfahren', steps: ['Rechts fahren', 'Tempo an Sicht, Wetter und Verkehr anpassen', 'Nicht unnötig langsam: <b>behindern</b> ist auch ein Fehler'] },
  { icon: '🦓', title: 'Zebrastreifen und Bus', steps: ['Nicht überholen am Zebrastreifen', 'Fußgänger will rüber: langsam ran, <b>anhalten</b>', 'Bus fährt mit Warnblinker an die Haltestelle: <b>nicht überholen</b>. Bus hält mit Warnblinker: nur <b>Schritttempo</b>, auch im Gegenverkehr'] },
];
---
<Section id="situationen" title="Fahraufgaben im Verkehr">
  <div class="columns-[3_300px] gap-x-3">
    {SITUATIONEN.map(s => (
      <Card icon={s.icon} title={s.title} class="mb-3 break-inside-avoid">
        <Steps items={s.steps} />
        {s.note && <Note class="mt-2">{s.note}</Note>}
      </Card>
    ))}
  </div>
</Section>

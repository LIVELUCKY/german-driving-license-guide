---
import Section from '../Section.astro';
import Card from '../ui/Card.astro';
import Grid from '../ui/Grid.astro';
import Kv from '../ui/Kv.astro';
import Note from '../ui/Note.astro';
import Tip from '../ui/Tip.astro';
import { RULER } from '../../data/cheatsheet';

const SIGN_SPOTS = [
  ['Gefahrzeichen außerorts', '150–250 m vor der Gefahr'],
  ['Gefahrzeichen innerorts', 'meist kürzer davor'],
  ['Autobahn-Ausfahrt', 'Baken 300 / 200 / 100 m'],
  ['Leitpfosten', 'alle 50 m'],
];
---
<Section id="meter" title="Die wichtigen Meter">
  <div class="ruler">
    {RULER.map(r => (
      <div class="rl">
        <span class="rl-m">{String(r.m).replace('.', ',')} m</span>
        <span class="rl-bar"><span style={`width:${Math.max(r.m / 50 * 100, 2)}%`}></span></span>
        <span class="rl-t">{r.t}<small>{r.s}</small></span>
      </div>
    ))}
  </div>
  <Tip label="Merksatz Parken">„<b>5</b> an der Ecke, <b>8</b> mit Radweg, <b>15</b> am Bus.“ <b>Halten</b> = bis 3 Minuten und du bleibst da. Länger oder ausgestiegen = <b>Parken</b>.</Tip>
  <Tip label="Merksatz Seitenabstand">„Anderthalb drinnen, zwei draußen.“ So viele Meter Platz beim Überholen von Rad, E-Scooter und Fußgänger.</Tip>

  <h3 class="mt-7 mb-3 font-display text-base uppercase tracking-[.04em]">Baken und Gefahrzeichen</h3>
  <Grid min={300}>
    <Card icon="🚂" title="Bahnübergang">
      <div class="diag">
        <svg viewBox="0 0 320 110" role="img" aria-label="Baken vor dem Bahnübergang bei 240, 160 und 80 Metern">
          <rect x="0" y="70" width="320" height="16" fill="#c7ced6"/>
          <g transform="translate(40,10)"><rect width="16" height="56" fill="#fff" stroke="#17171b"/><path d="M0 14 L16 6 M0 30 L16 22 M0 46 L16 38" stroke="#d92f2f" stroke-width="5"/></g>
          <g transform="translate(130,10)"><rect width="16" height="56" fill="#fff" stroke="#17171b"/><path d="M0 22 L16 14 M0 40 L16 32" stroke="#d92f2f" stroke-width="5"/></g>
          <g transform="translate(220,10)"><rect width="16" height="56" fill="#fff" stroke="#17171b"/><path d="M0 32 L16 24" stroke="#d92f2f" stroke-width="5"/></g>
          <path d="M290 20 L310 60 M310 20 L290 60" stroke="#d92f2f" stroke-width="6"/>
          <text x="48" y="104" font-size="13" text-anchor="middle" font-weight="800" fill="var(--ink)">240 m</text>
          <text x="138" y="104" font-size="13" text-anchor="middle" font-weight="800" fill="var(--ink)">160 m</text>
          <text x="228" y="104" font-size="13" text-anchor="middle" font-weight="800" fill="var(--ink)">80 m</text>
        </svg>
      </div>
      <Note class="mt-2"><b>Bake</b> = Brett mit roten Schrägstreifen vor dem Bahnübergang. Jeder Streifen = 80 m. Ab der ersten Bake (Zeichen 156) <b>keine Kraftfahrzeuge überholen</b>. Andreaskreuz (rot-weißes Kreuz am Bahnübergang) = Bahn hat <b>immer</b> Vorrang.</Note>
      <Tip label="Merksatz">„Drei Streifen, je 80 Meter.“ „Ab der Bake keine Kfz überholen.“</Tip>
      <Tip label="Merksatz">„Andreaskreuz: drinnen 5, draußen 50.“ So viele Meter Parkverbot davor und dahinter, innerorts und außerorts.</Tip>
    </Card>
    <Card icon="⚠️" title="Wo Schilder stehen">
      {SIGN_SPOTS.map(([l, v]) => <Kv label={l!}>{v}</Kv>)}
      <Tip label={false}>Deutlich kürzer? Dann steht die Entfernung auf einer <b>Zusatztafel</b> (kleines weißes Schild unter dem Hauptschild), z. B. „in 50 m“.</Tip>
      <Tip label="Merksatz">„Gelb vor Weiß.“ In Baustellen gelten die gelben Linien, die weißen nicht mehr (§ 39 Abs. 5).</Tip>
    </Card>
  </Grid>
</Section>

<style>
  .ruler{display:flex;flex-direction:column;gap:6px}
  .rl{display:grid;grid-template-columns:76px minmax(60px,1fr) minmax(0,1.6fr);gap:12px;align-items:center;padding:6px 0;border-bottom:1px dashed var(--soft)}
  .rl-m{font-family:var(--display);font-size:1.05rem;text-align:right}
  .rl-bar{height:12px;background:var(--soft);border-radius:2px;overflow:hidden}
  .rl-bar span{display:block;height:100%;background:var(--pop2)}
  .rl-t{font-size:.88rem;line-height:1.35}
  .rl-t small{display:block;color:inherit;opacity:.8;font-size:.74rem}
  @media(max-width:600px){.rl{grid-template-columns:70px 1fr}.rl-bar{display:none}}
  .diag svg{width:100%;height:auto;background:var(--bg2);border:2px solid var(--line);border-radius:var(--r)}
</style>

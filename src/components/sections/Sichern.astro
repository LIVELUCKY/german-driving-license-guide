---
import Section from '../Section.astro';
import Card from '../ui/Card.astro';
import Grid from '../ui/Grid.astro';
import Kv from '../ui/Kv.astro';
import Note from '../ui/Note.astro';
import Steps from '../ui/Steps.astro';
import Tip from '../ui/Tip.astro';

const GANG = [
  ['bergauf', '1. Gang + Handbremse'],
  ['bergab', 'Rückwärtsgang + Handbremse'],
  ['Automatik', 'erst Handbremse, dann P'],
];
const BORDSTEIN = [
  ['bergab mit Bordstein', 'Räder zum Bordstein'],
  ['bergauf mit Bordstein', 'Räder vom Bordstein weg'],
];
const VERLASSEN = [
  'Richtig parken',
  'Gegen Wegrollen sichern: Gang und Handbremse, oder P',
  'Schlüssel ab, Lenkradschloss, abschließen (§ 14: gegen unbefugte Benutzung)',
  'Vor und beim Türöffnen auf Verkehr achten, niemanden gefährden',
];
const TECHNIK = [
  ['Ölstand', 'Messstab, zwischen min und max, Motor aus, Auto eben'],
  ['Kühlmittel', 'Ausgleichsbehälter, min/max, nur kalt öffnen'],
  ['Bremsflüssigkeit', 'Behälter, zwischen min und max'],
  ['Wischwasser', 'Behälter mit Scheiben-Symbol'],
  ['Reifendruck', 'Aufkleber in Tür oder Tankklappe, kalt prüfen'],
  ['Profil', 'mind. 1,6 mm, TWI-Stege im Profil (kleine Stege in der Profilrille, zeigen 1,6 mm an)'],
  ['Licht', 'rundum gehen; Bremslicht mit Helfer oder Spiegelung'],
];
---
<Section id="sichern" title="Auto sichern und bedienen">
  <Grid min={300}>
    <Card icon="⛰️" title="Am Berg parken">
      {GANG.map(([l, v]) => <Kv label={l!}>{v}</Kv>)}
      <Tip label="Merksatz">„Gang gegen die Rollrichtung.“</Tip>
      {BORDSTEIN.map(([l, v]) => <Kv label={l!}>{v}</Kv>)}
      <Tip label="Merksatz">„Bergab zum Bord, bergauf davon.“</Tip>
    </Card>
    <Card icon="🔑" title="Auto verlassen und Prüfungsende">
      <Steps items={VERLASSEN} />
      <Note class="mt-2">Nach einer Panne: sofort Warnblinker, dann Warndreieck (§ 15).</Note>
    </Card>
    <Card icon="🎛️" title="Bedienelemente im Griff">
      <Note>In der Prüfung musst du Licht, Wischer und Waschanlage, Heizung, Lüftung und Heckscheibenheizung <b>selbst richtig</b> nutzen. <b>Licht oder Wischer</b> gar nicht nutzen, wenn es nötig wäre = schwerer Fehler.</Note>
      <Tip label="Beschlagene Scheibe">Gebläse auf die Frontscheibe, stärker stellen, Klima an, Heckscheibenheizung an.</Tip>
    </Card>
    <Card icon="🔧" title="Falls der Prüfer Technik fragt">
      <Note class="mb-1">Offiziell gibt es für Klasse B keine Pflicht-Technikfragen mehr. Manche Prüfer fragen trotzdem.</Note>
      {TECHNIK.map(([l, v]) => <Kv label={l!}>{v}</Kv>)}
    </Card>
  </Grid>
</Section>

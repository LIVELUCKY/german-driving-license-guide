---
import Section from '../Section.astro';
import Card from '../ui/Card.astro';
import Grid from '../ui/Grid.astro';
import Kv from '../ui/Kv.astro';
import Note from '../ui/Note.astro';
import Tip from '../ui/Tip.astro';

// Blood alcohol limits (§ 24a StVG, § 316 StGB, FeV § 13).
const ZONES = [
  { w: 0.5, color: 'bg-go' },
  { w: 16, color: 'bg-[#9fd8a0]' },
  { w: 11, color: 'bg-[#f5b50a]' },
  { w: 33, color: 'bg-[#f08c2e]' },
  { w: 39.5, color: 'bg-warn' },
];
const TICKS = [
  ['0,0', 'Probezeit & unter 21: Grenze'],
  ['0,3', 'mit Ausfallerscheinung (z. B. Unfall wegen Alkohol): Straftat'],
  ['0,5', 'immer: Ordnungswidrigkeit, Fahrverbot'],
  ['1,1', 'absolut fahruntüchtig: Straftat'],
  ['1,6', 'MPU (auch auf dem Fahrrad)'],
];
---
<Section id="alkohol" title="Alkohol und Drogen">
  <div class="rounded-box border-2 border-line bg-surface px-4 pt-[18px] pb-3" role="img" aria-label="Promilleskala">
    <div class="flex h-[26px] overflow-hidden rounded">
      {ZONES.map(z => <span class={z.color} style={`width:${z.w}%`}></span>)}
    </div>
    <div class="mt-2.5 grid grid-cols-2 gap-2 sm:grid-cols-5">
      {TICKS.map(([v, t]) => (
        <span class="text-[.75rem] leading-[1.3] text-muted"><b class="block font-display text-[1.1rem] text-ink">{v}</b>{t}</span>
      ))}
    </div>
  </div>
  <Note class="mt-3">
    <b>Ausfallerscheinung</b> = Fahrfehler durch Alkohol, z. B. Schlangenlinien oder Unfall. <b>Ordnungswidrigkeit</b> = Bußgeld, kein Strafgericht. <b>Absolut fahruntüchtig</b> = ab 1,1 ‰ immer strafbar, auch ohne Fahrfehler. <b>MPU</b> = Medizinisch-Psychologische Untersuchung (Gutachten, ob du wieder fahren darfst).
  </Note>
  <Tip label="Merksatz">„<b>Null Komma null</b>, solang du neu bist.“ Dann: „<b>Drei</b> mit Fehler, <b>fünf</b> ist teuer, <b>elf</b> ist Straftat, <b>sechzehn</b> MPU.“</Tip>

  <Grid class="mt-4">
    <Card icon="🍺" title="Abbau">
      <Kv label="pro Stunde">ca. 0,1 ‰</Kv>
      <Tip>Kaffee, Schlaf oder Dusche beschleunigen <b>nichts</b>. Nur Zeit hilft. Restalkohol am Morgen zählt.</Tip>
      <Tip label="Merksatz">„Pro Stunde nur ein Zehntel.“</Tip>
    </Card>
    <Card icon="🌿" title="Cannabis">
      <Kv label="THC-Grenzwert">3,5 ng/ml</Kv>
      <Kv label="mit Alkohol">verboten</Kv>
      <Kv label="Probezeit / unter 21">verboten</Kv>
      <Note class="mt-2">ng/ml = Nanogramm THC pro Milliliter Blutserum.</Note>
      <Tip label="Merksatz">„3,5 und nie mit Alkohol.“</Tip>
    </Card>
    <Card icon="💊" title="Medikamente">
      <Tip>Beipackzettel lesen. Wer fahruntüchtig ist, macht sich strafbar, auch mit Rezept. Andere illegale Drogen: <b>null</b> Toleranz.</Tip>
    </Card>
    <Card icon="😴" title="Müdigkeit">
      <Kv label="Pause">alle ca. 2 Stunden</Kv>
      <Kv label="Powernap">Kaffee + ca. 20 Min Schlaf</Kv>
      <Tip>Sekundenschlaf: bei 100 km/h fährst du in 1 Sekunde fast <b>28 m</b> blind.</Tip>
    </Card>
  </Grid>
</Section>

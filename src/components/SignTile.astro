---
// eslint-disable-next-line @typescript-eslint/no-explicit-any
const { sign, eager = false } = Astro.props as { sign: any; eager?: boolean };
const kw = (sign.kw + ' ' + sign.nameDe + ' ' + (sign.stvo ?? '')).toLowerCase();
---
<div class="sign" data-kw={kw} tabindex="0" role="group" aria-label={sign.nameDe}>
  <div class="sign-inner">
    <div class="sign-front">
      {sign.img
        ? <img src={sign.img} alt={sign.nameDe} width="72" height="72" decoding="async" loading={eager ? 'eager' : 'lazy'} />
        : <Fragment set:html={sign.drawn} />}
      <div class="nm">{sign.nameDe}</div>
      {sign.stvo && <div class="no">Zeichen {sign.stvo}</div>}
    </div>
    <div class="sign-back">
      <div class="mn" set:html={sign.de} />
      {sign.tipDe && <div class="tip" set:html={sign.tipDe} />}
    </div>
  </div>
</div>
